@@ -0,0 +1,67 @@
+// Copyright 2026 Roadium Browser contributors.
+// SPDX-License-Identifier: GPL-3.0-only
+
+#ifndef COMPONENTS_ADBLOCK_CORE_SUBSCRIPTION_SUBSCRIPTION_STORAGE_TRANSACTION_H_
+#define COMPONENTS_ADBLOCK_CORE_SUBSCRIPTION_SUBSCRIPTION_STORAGE_TRANSACTION_H_
+
+#include <atomic>
+#include <memory>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/ref_counted.h"
+#include "components/adblock/core/subscription/subscription_persistent_metadata.h"
+#include "components/adblock/core/subscription/subscription_validator.h"
+
+namespace adblock::storage {
+
+// A cancellation signal, not a callback into the main sequence. File operations
+// use a single sequenced runner; a newer publication cannot be overtaken.
+class Permit : public base::RefCountedThreadSafe<Permit> {
+ public:
+  explicit Permit(bool allowed);
+  std::atomic_bool data;
+
+ private:
+  friend class base::RefCountedThreadSafe<Permit>;
+  ~Permit() = default;
+};
+
+struct Generation {
+  std::unique_ptr<FlatbufferData> data;
+  base::FilePath path;
+  SubscriptionDiagnostics diagnostics;
+  base::Time installed;
+  std::string recovery;
+  std::string error;
+};
+
+// Optional per-instance fault observer for deterministic tests. Not exposed to
+// Java, preferences, switches, network content or the release UI. Returning
+// false simulates an interruption at the named boundary, without performing
+// cleanup.
+using Boundary = base::RepeatingCallback<bool(std::string_view)>;
+
+std::optional<GURL> ValidatedIdentity(const FlatbufferData& data);
+
+std::vector<Generation> Load(
+    const base::FilePath& directory,
+    SubscriptionValidator::IsSignatureValidThreadSafeCallback legacy_signature);
+Generation Commit(
+    const base::FilePath& directory,
+    std::unique_ptr<FlatbufferData> data,
+    SubscriptionDiagnostics diagnostics,
+    SubscriptionValidator::IsSignatureValidThreadSafeCallback legacy_signature,
+    scoped_refptr<Permit> permit,
+    Boundary boundary = {});
+// Explicit removal clears both generations. Discarding a cancelled candidate
+// rolls back only if that exact file is still current, preserving newer work.
+void Remove(const base::FilePath& directory,
+            const GURL& identity,
+            const base::FilePath& file,
+            bool discard_candidate);
+
+}  // namespace adblock::storage
+
+#endif
