+namespace adblock::storage {
+Permit::Permit(bool allowed) : data(allowed) {}
+
+namespace {
+// Conversion expands indexes beyond the 32 MiB plaintext transport ceiling.
+// Bound each persisted generation independently without imposing that input
+// ceiling on the larger binary representation.
+constexpr size_t kMaximumBytes = 128 * 1024 * 1024;
+constexpr size_t kMaximumRecordBytes = 16 * 1024;
+
+std::string Hash(base::span<const uint8_t> bytes) {
+  return base::HexEncodeLower(crypto::SHA256Hash(bytes));
+}
+std::string Prefix(const GURL& identity) {
+  return "roadium-" + Hash(base::as_byte_span(identity.spec()));
+}
+base::FilePath RecordPath(const base::FilePath& directory,
+                          const GURL& identity,
+                          bool previous) {
+  return directory.AppendASCII(Prefix(identity) +
+                               (previous ? ".previous.json" : ".current.json"));
+}
+bool Hex(std::string_view text, size_t length) {
+  return text.size() == length &&
+         std::ranges::all_of(text, base::IsHexDigit<char>);
+}
+bool LegacyName(std::string_view name) {
+  return name.ends_with(".fb") && Hex(name.substr(0, name.size() - 3), 32);
+}
+bool GenerationName(std::string_view name) {
+  return name.size() == 108 && name.starts_with("roadium-") &&
+         Hex(name.substr(8, 64), 64) && name[72] == '-' &&
+         Hex(name.substr(73, 32), 32) && name.ends_with(".fb");
+}
+bool RecordName(std::string_view name) {
+  return name.starts_with("roadium-") && name.size() > 72 &&
+         Hex(name.substr(8, 64), 64) &&
+         (name.substr(72) == ".current.json" ||
+          name.substr(72) == ".previous.json");
+}
+bool SafeFile(const base::FilePath& directory, std::string_view name) {
+  return (GenerationName(name) || LegacyName(name)) &&
+         !base::IsLink(directory.AppendASCII(name));
+}
+bool SyncDirectory(const base::FilePath& directory) {
+#if BUILDFLAG(IS_POSIX)
+  base::ScopedFD fd(HANDLE_EINTR(
+      open(directory.value().c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC)));
+  return fd.is_valid() && HANDLE_EINTR(fsync(fd.get())) == 0;
+#else
+  // Atomic replacement is available elsewhere, but Android/POSIX directory
+  // durability is the supported Card 05 contract.
+  return true;
+#endif
+}
+bool Publish(const base::FilePath& directory,
+             const base::FilePath& path,
+             const base::DictValue& record) {
+  std::string json;
+  // A fixed owned pending name bounds interrupted metadata writes. No generic
+  // temporary-file sweep, and no attempt to infer a commit from pending bytes.
+  const auto pending = path.AddExtensionASCII("pending");
+  if (base::IsLink(path) || base::IsLink(pending) ||
+      !base::JSONWriter::Write(record, &json) ||
+      json.size() > kMaximumRecordBytes) {
+    return false;
+  }
+  {
+    base::File file(pending,
+                    base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE);
+    if (!file.IsValid() || !file.WriteAndCheck(0, base::as_byte_span(json)) ||
+        !file.Flush()) {
+      file.Close();
+      base::DeleteFile(pending);
+      return false;
+    }
+  }
+  if (!base::ReplaceFile(pending, path, nullptr)) {
+    base::DeleteFile(pending);
+    return false;
+  }
+  return SyncDirectory(directory);
+}
+
+bool Valid(const FlatbufferData& data, const GURL& expected = GURL()) {
+  if (!data.data() || !data.size() || data.size() > kMaximumBytes) {
+    return false;
+  }
+  flatbuffers::Verifier verifier(data.data(), data.size());
+  if (!flat::VerifySubscriptionBuffer(verifier)) {
+    return false;
+  }
+  const auto* sub = flat::GetSubscription(data.data());
+  const auto* metadata = sub->metadata();
+  if (!metadata || !metadata->url() ||
+      !metadata->flatbuffers_schema_version() ||
+      metadata->flatbuffers_schema_version()->str() != CurrentSchemaVersion()) {
+    return false;
+  }
+  const GURL identity(metadata->url()->str());
+  if (!identity.is_valid() || metadata->url()->str() != identity.spec() ||
+      (!expected.is_empty() && identity != expected)) {
+    return false;
+  }
+  // Old and recovered privileged bytes never grant a custom identity trust.
+  if (!config::AllowPrivilegedFilters(identity) &&
+      ((sub->snippet() && sub->snippet()->size()) ||
+       (sub->inline_css() && sub->inline_css()->size()))) {
+    return false;
+  }
+  // A one-rule list is valid. Empty custom rules are held in memory and never
+  // reach this store. Require an actual supported index, not an arbitrary size
+  // or percentage threshold that would reject small legitimate lists.
+  return (sub->url_subresource_block() &&
+          sub->url_subresource_block()->size()) ||
+         (sub->url_subresource_allow() &&
+          sub->url_subresource_allow()->size()) ||
+         (sub->url_popup_block() && sub->url_popup_block()->size()) ||
+         (sub->url_popup_allow() && sub->url_popup_allow()->size()) ||
+         (sub->url_document_allow() && sub->url_document_allow()->size()) ||
+         (sub->url_elemhide_allow() && sub->url_elemhide_allow()->size()) ||
+         (sub->url_generichide_allow() &&
+          sub->url_generichide_allow()->size()) ||
+         (sub->url_genericblock_allow() &&
+          sub->url_genericblock_allow()->size()) ||
+         (sub->url_csp_block() && sub->url_csp_block()->size()) ||
+         (sub->url_csp_allow() && sub->url_csp_allow()->size()) ||
+         (sub->url_rewrite_block() && sub->url_rewrite_block()->size()) ||
+         (sub->url_rewrite_allow() && sub->url_rewrite_allow()->size()) ||
+         (sub->elemhide() && sub->elemhide()->size()) ||
+         (sub->elemhide_emulation() && sub->elemhide_emulation()->size()) ||
+         (sub->elemhide_exception() && sub->elemhide_exception()->size()) ||
+         (sub->remove() && sub->remove()->size()) ||
+         (sub->inline_css() && sub->inline_css()->size()) ||
+         (sub->snippet() && sub->snippet()->size());
+}
+GURL Identity(const FlatbufferData& data) {
+  return GURL(flat::GetSubscription(data.data())->metadata()->url()->str());
+}
+std::optional<base::DictValue> ReadRecord(const base::FilePath& directory,
+                                          const base::FilePath& path) {
+  std::string json;
+  if (base::IsLink(path) ||
+      !base::ReadFileToStringWithMaxSize(path, &json, kMaximumRecordBytes)) {
+    return {};
+  }
+  auto record = base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!record || record->FindInt("format") != 1) {
+    return {};
+  }
+  const auto* url = record->FindString("identity");
+  const auto* name = record->FindString("file");
+  const auto* digest = record->FindString("sha256");
+  const auto* schema = record->FindString("schema");
+  if (!url || !name || !digest || !schema || !GURL(*url).is_valid() ||
+      GURL(*url).spec() != *url || !SafeFile(directory, *name) ||
+      !Hex(*digest, 64) ||
+      (GenerationName(*name) && !name->starts_with(Prefix(GURL(*url)) + "-")) ||
+      (path != RecordPath(directory, GURL(*url), false) &&
+       path != RecordPath(directory, GURL(*url), true))) {
+    return {};
+  }
+  return record;
+}
+Generation ReadGeneration(const base::FilePath& directory,
+                          const base::DictValue& record,
+                          std::string recovery) {
+  Generation result;
+  if (*record.FindString("schema") != CurrentSchemaVersion()) {
+    return result;
+  }
+  const auto path = directory.AppendASCII(*record.FindString("file"));
+  std::string bytes;
+  if (!base::ReadFileToStringWithMaxSize(path, &bytes, kMaximumBytes)) {
+    return result;
+  }
+  auto data = std::make_unique<InMemoryFlatbufferData>(std::move(bytes));
+  if (Hash(data->span()) != *record.FindString("sha256") ||
+      !Valid(*data, GURL(*record.FindString("identity")))) {
+    return result;
+  }
+  auto mapped = std::make_unique<MemoryMappedFlatbufferData>(path);
+  if (!mapped->data() || Hash(mapped->span()) != *record.FindString("sha256")) {
+    return result;
+  }
+  result.data = std::move(mapped);
+  result.path = path;
+  result.recovery = std::move(recovery);
+  result.diagnostics.last_success_source =
+      record.FindString("source") ? record.FindString("source")->substr(0, 2048)
+                                  : "";
+  result.diagnostics.active_privileged = record.FindBool("privileged");
+  if (auto accepted = record.FindInt("accepted"); accepted && *accepted > 0) {
+    RuleStatistics rules;
+    rules.accepted = *accepted;
+    rules.parser_rejected =
+        std::max(0, record.FindInt("parser_rejected").value_or(0));
+    rules.unsupported_commands =
+        std::max(0, record.FindInt("unsupported_commands").value_or(0));
+    rules.prohibited_privilege =
+        std::max(0, record.FindInt("prohibited_privilege").value_or(0));
+    rules.unsafe_arguments =
+        std::max(0, record.FindInt("unsafe_arguments").value_or(0));
+    rules.unsupported_options =
+        std::max(0, record.FindInt("unsupported_options").value_or(0));
+    result.diagnostics.active_rules = rules;
+  }
+  if (const auto* time = record.FindString("installed")) {
+    int64_t micros;
+    if (base::StringToInt64(*time, &micros)) {
+      result.installed =
+          base::Time::FromDeltaSinceWindowsEpoch(base::Microseconds(micros));
+    }
+  }
+  return result;
+}
+base::DictValue MakeRecord(const Generation& generation) {
+  auto record =
+      base::DictValue()
+          .Set("format", 1)
+          .Set("identity", Identity(*generation.data).spec())
+          .Set("file", generation.path.BaseName().AsUTF8Unsafe())
+          .Set("sha256", Hash(generation.data->span()))
+          .Set("schema", CurrentSchemaVersion())
+          .Set("source",
+               generation.diagnostics.last_success_source.substr(0, 2048))
+          .Set("installed", base::NumberToString(
+                                generation.installed.ToDeltaSinceWindowsEpoch()
+                                    .InMicroseconds()));
+  if (generation.diagnostics.active_privileged) {
+    record.Set("privileged", *generation.diagnostics.active_privileged);
+  }
+  if (generation.diagnostics.active_rules) {
+    const auto& rules = *generation.diagnostics.active_rules;
+    record.Set("accepted", rules.accepted);
+    record.Set("parser_rejected", rules.parser_rejected);
+    record.Set("unsupported_commands", rules.unsupported_commands);
+    record.Set("prohibited_privilege", rules.prohibited_privilege);
+    record.Set("unsafe_arguments", rules.unsafe_arguments);
+    record.Set("unsupported_options", rules.unsupported_options);
+  }
+  return record;
+}
+
+std::map<GURL, Generation> Legacy(
+    const base::FilePath& directory,
+    SubscriptionValidator::IsSignatureValidThreadSafeCallback signature) {
+  std::map<GURL, Generation> result;
+  base::FileEnumerator enumerator(directory, false,
+                                  base::FileEnumerator::FILES);
+  for (auto path = enumerator.Next(); !path.empty(); path = enumerator.Next()) {
+    if (!LegacyName(path.BaseName().AsUTF8Unsafe()) || base::IsLink(path)) {
+      continue;
+    }
+    std::string bytes;
+    if (!base::ReadFileToStringWithMaxSize(path, &bytes, kMaximumBytes)) {
+      continue;
+    }
+    auto data = std::make_unique<InMemoryFlatbufferData>(std::move(bytes));
+    if (!Valid(*data) || !signature.Run(*data, path)) {
+      continue;
+    }
+    const auto url = Identity(*data);
+    auto& selected = result[url];
+    // Deterministic migration only. Existing metadata never established which
+    // duplicate was committed; choose latest mtime, then filename as tie-break.
+    const auto modified = enumerator.GetInfo().GetLastModifiedTime();
+    if (selected.data &&
+        (modified < selected.installed ||
+         (modified == selected.installed && path < selected.path))) {
+      continue;
+    }
+    selected.data = std::move(data);
+    selected.path = path;
+    selected.installed = modified;
+    selected.recovery = "legacy validated";
+  }
+  return result;
+}
+
+// Never infer trust from an orphan's bytes or scan an arbitrary directory tree.
+// Only this exact generation grammar is owned. Preserve all files referenced by
+// structurally valid records, even if their bytes/schema cannot currently load.
+void Prune(
+    const base::FilePath& directory,
+    SubscriptionValidator::IsSignatureValidThreadSafeCallback signature = {}) {
+  std::set<std::string> retained;
+  std::vector<base::FilePath> candidates;
+  std::vector<base::FilePath> legacy;
+  std::set<std::string> recorded_prefixes;
+  base::FileEnumerator enumerator(directory, false,
+                                  base::FileEnumerator::FILES);
+  for (auto path = enumerator.Next(); !path.empty(); path = enumerator.Next()) {
+    const auto name = path.BaseName().AsUTF8Unsafe();
+    if (RecordName(name)) {
+      recorded_prefixes.insert(name.substr(0, 72));
+      if (auto record = ReadRecord(directory, path)) {
+        retained.insert(*record->FindString("file"));
+      }
+    } else if (LegacyName(name) && !base::IsLink(path)) {
+      legacy.push_back(path);
+    } else if (GenerationName(name) && !base::IsLink(path)) {
+      candidates.push_back(path);
+    } else if (name.ends_with(".pending") &&
+               RecordName(std::string_view(name).substr(0, name.size() - 8)) &&
+               !base::IsLink(path)) {
+      base::DeleteFile(path);
+    }
+  }
+  if (signature) {
+    for (const auto& path : legacy) {
+      if (retained.contains(path.BaseName().AsUTF8Unsafe())) {
+        continue;
+      }
+      std::string bytes;
+      if (!base::ReadFileToStringWithMaxSize(path, &bytes, kMaximumBytes)) {
+        continue;
+      }
+      InMemoryFlatbufferData data(std::move(bytes));
+      if (Valid(data) && signature.Run(data, path) &&
+          recorded_prefixes.contains(Prefix(Identity(data)))) {
+        base::DeleteFile(path);
+      }
+    }
+  }
+  for (const auto& path : candidates) {
+    if (!retained.contains(path.BaseName().AsUTF8Unsafe())) {
+      base::DeleteFile(path);
+    }
+  }
+}
+bool Continue(const Boundary& boundary, std::string_view name) {
+  return !boundary || boundary.Run(name);
+}
+Generation Failure(std::string error) {
+  Generation result;
+  result.error = std::move(error);
+  return result;
+}
+}  // namespace
+
+std::optional<GURL> ValidatedIdentity(const FlatbufferData& data) {
+  return Valid(data) ? std::optional<GURL>(Identity(data)) : std::nullopt;
+}
+
+std::vector<Generation> Load(
+    const base::FilePath& directory,
+    SubscriptionValidator::IsSignatureValidThreadSafeCallback
+        legacy_signature) {
+  base::CreateDirectory(directory);
+  auto selected = Legacy(directory, legacy_signature);
+  std::set<GURL> recorded;
+  std::set<std::string> recorded_prefixes;
+  base::FileEnumerator enumerator(directory, false,
+                                  base::FileEnumerator::FILES);
+  for (auto path = enumerator.Next(); !path.empty(); path = enumerator.Next()) {
+    if (!RecordName(path.BaseName().AsUTF8Unsafe())) {
+      continue;
+    }
+    recorded_prefixes.insert(path.BaseName().AsUTF8Unsafe().substr(0, 72));
+    auto record = ReadRecord(directory, path);
+    if (record) {
+      recorded.insert(GURL(*record->FindString("identity")));
+    }
+  }
+  std::erase_if(selected, [&](const auto& item) {
+    return recorded_prefixes.contains(Prefix(item.first));
+  });
+  for (const auto& url : recorded) {
+    selected.erase(
+        url);  // Never resurrect legacy data behind an existing record.
+    for (bool previous : {false, true}) {
+      auto record = ReadRecord(directory, RecordPath(directory, url, previous));
+      if (!record) {
+        continue;
+      }
+      auto generation =
+          ReadGeneration(directory, *record, previous ? "previous" : "current");
+      if (generation.data) {
+        selected.emplace(url, std::move(generation));
+        break;
+      }
+    }
+  }
+  Prune(directory, legacy_signature);
+  std::vector<Generation> result;
+  for (auto& [url, generation] : selected) {
+    result.push_back(std::move(generation));
+  }
+  return result;
+}
+
+Generation Commit(
+    const base::FilePath& directory,
+    std::unique_ptr<FlatbufferData> data,
+    SubscriptionDiagnostics diagnostics,
+    SubscriptionValidator::IsSignatureValidThreadSafeCallback legacy_signature,
+    scoped_refptr<Permit> permit,
+    Boundary boundary) {
+  if (!data || !Valid(*data)) {
+    return Failure("Candidate validation failed");
+  }
+  if (!permit->data.load()) {
+    return Failure("Storage activation cancelled");
+  }
+  if (!base::CreateDirectory(directory)) {
+    return Failure("Storage directory unavailable");
+  }
+  const auto url = Identity(*data);
+  Generation selected;
+  const bool has_record = base::PathExists(RecordPath(directory, url, false)) ||
+                          base::PathExists(RecordPath(directory, url, true));
+  for (bool previous : {false, true}) {
+    if (auto record =
+            ReadRecord(directory, RecordPath(directory, url, previous))) {
+      selected =
+          ReadGeneration(directory, *record, previous ? "previous" : "current");
+      if (selected.data) {
+        break;
+      }
+    }
+  }
+  if (!selected.data && !has_record) {
+    auto legacy = Legacy(directory, legacy_signature);
+    if (auto it = legacy.find(url); it != legacy.end()) {
+      selected = std::move(it->second);
+    }
+  }
+  Generation* prior = selected.data ? &selected : nullptr;
+  Generation candidate;
+  candidate.path = directory.AppendASCII(
+      Prefix(url) + "-" + base::UnguessableToken::Create().ToString() + ".fb");
+  candidate.installed = base::Time::Now();
+  candidate.diagnostics.last_success_source = diagnostics.source;
+  candidate.diagnostics.active_privileged = diagnostics.parsed_privileged;
+  candidate.diagnostics.active_rules = data->GetRuleStatistics();
+  candidate.recovery = "current";
+  {
+    base::File file(candidate.path,
+                    base::File::FLAG_CREATE | base::File::FLAG_WRITE);
+    if (!file.IsValid() || !file.WriteAndCheck(0, data->span()) ||
+        !file.Flush()) {
+      file.Close();
+      base::DeleteFile(candidate.path);
+      return Failure("Candidate write or flush failed");
+    }
+  }
+  if (!SyncDirectory(directory)) {
+    base::DeleteFile(candidate.path);
+    return Failure("Candidate directory sync failed");
+  }
+  if (!Continue(boundary, "candidate persisted")) {
+    return Failure("Interrupted before publication");
+  }
+  candidate.data = std::make_unique<MemoryMappedFlatbufferData>(candidate.path);
+  if (!candidate.data->data() || !Valid(*candidate.data, url) ||
+      Hash(candidate.data->span()) != Hash(data->span())) {
+    base::DeleteFile(candidate.path);
+    return Failure("Persisted candidate failed validation");
+  }
+  if (!permit->data.load()) {
+    base::DeleteFile(candidate.path);
+    return Failure("Storage activation cancelled");
+  }
+  if (prior) {
+    base::File prior_file(prior->path,
+                          base::File::FLAG_OPEN | base::File::FLAG_WRITE);
+    if (!prior_file.IsValid() || !prior_file.Flush() ||
+        !SyncDirectory(directory)) {
+      base::DeleteFile(candidate.path);
+      return Failure("Previous generation flush failed");
+    }
+  }
+  if (prior && !Publish(directory, RecordPath(directory, url, true),
+                        MakeRecord(*prior))) {
+    base::DeleteFile(candidate.path);
+    return Failure("Previous record publication failed");
+  }
+  if (!Continue(boundary, "previous published")) {
+    return Failure("Interrupted before current publication");
+  }
+  if (!permit->data.load()) {
+    base::DeleteFile(candidate.path);
+    return Failure("Storage activation cancelled");
+  }
+  if (!Publish(directory, RecordPath(directory, url, false),
+               MakeRecord(candidate))) {
+    // A directory-sync failure can occur after rename. Keep the flushed
+    // candidate if a record now references it; old/previous is still a valid
+    // recovery point.
+    Prune(directory, legacy_signature);
+    return Failure("Current record publication or directory sync failed");
+  }
+  if (!Continue(boundary, "current published")) {
+    return Failure("Interrupted after current publication");
+  }
+  Prune(directory, legacy_signature);
+  if (!Continue(boundary, "obsolete cleaned")) {
+    return Failure("Interrupted after obsolete cleanup");
+  }
+  return candidate;
+}
+
+void Remove(const base::FilePath& directory,
+            const GURL& identity,
+            const base::FilePath& file,
+            bool discard_candidate) {
+  if (discard_candidate) {
+    auto current =
+        ReadRecord(directory, RecordPath(directory, identity, false));
+    if (current &&
+        directory.AppendASCII(*current->FindString("file")) == file) {
+      auto previous =
+          ReadRecord(directory, RecordPath(directory, identity, true));
+      if (previous) {
+        if (!Publish(directory, RecordPath(directory, identity, false),
+                     *previous)) {
+          return;
+        }
+      } else {
+        base::DeleteFile(RecordPath(directory, identity, false));
+        SyncDirectory(directory);
+      }
+    }
+  } else {
+    for (bool previous : {false, true}) {
+      const auto path = RecordPath(directory, identity, previous);
+      if (auto record = ReadRecord(directory, path)) {
+        const auto retained =
+            directory.AppendASCII(*record->FindString("file"));
+        if (LegacyName(retained.BaseName().AsUTF8Unsafe())) {
+          base::DeleteFile(retained);
+        }
+      }
+      if (!base::IsLink(path)) {
+        base::DeleteFile(path);
+      }
+    }
+    SyncDirectory(directory);
+    // Legacy data is removed only through an exact already-validated mapping.
+    if (file.DirName() == directory &&
+        LegacyName(file.BaseName().AsUTF8Unsafe()) && !base::IsLink(file)) {
+      base::DeleteFile(file);
+    }
+  }
+  Prune(directory);
+}
+}  // namespace adblock::storage
