+namespace adblock {
+namespace {
+const GURL& Identity() {
+  static const base::NoDestructor<GURL> url(
+      "https://uazo.github.io/cromite/filters/easylist.txt");
+  return *url;
+}
+auto NoLegacy() {
+  return base::BindRepeating(
+      [](const FlatbufferData&, const base::FilePath&) { return false; });
+}
+std::unique_ptr<FlatbufferData> Data(std::string version,
+                                     const GURL& identity = Identity()) {
+  std::istringstream text("[Adblock Plus 2.0]\n! Version: " + version +
+                          "\n||ads.recovery.invalid^\nrecovery.invalid##.ad\n");
+  auto result = base::MakeRefCounted<FlatbufferConverter>()->Convert(
+      text, identity, false);
+  auto* data = std::get_if<std::unique_ptr<FlatbufferData>>(&result);
+  return data ? std::move(*data) : nullptr;
+}
+scoped_refptr<InstalledSubscription> Installed(
+    storage::Generation& generation) {
+  return base::MakeRefCounted<InstalledSubscriptionImpl>(
+      std::move(generation.data), Subscription::InstallationState::Installed,
+      generation.installed);
+}
+class ShieldsRecoveryTest : public testing::Test {
+ public:
+  void SetUp() override { ASSERT_TRUE(directory.CreateUniqueTempDir()); }
+  storage::Generation Commit(std::string version,
+                             storage::Boundary boundary = {}) {
+    SubscriptionDiagnostics d;
+    d.source =
+        "https://raw.githubusercontent.com/uazo/cromite/pages/filters/"
+        "easylist.txt";
+    d.parsed_privileged = false;
+    return storage::Commit(directory.GetPath(), Data(version), d, NoLegacy(),
+                           base::MakeRefCounted<storage::Permit>(true),
+                           boundary);
+  }
+  std::vector<storage::Generation> Load() {
+    return storage::Load(directory.GetPath(), NoLegacy());
+  }
+  base::FilePath Record(bool previous = false) {
+    base::FileEnumerator files(directory.GetPath(), false,
+                               base::FileEnumerator::FILES);
+    for (auto path = files.Next(); !path.empty(); path = files.Next()) {
+      if (path.BaseName().AsUTF8Unsafe().ends_with(
+              previous ? ".previous.json" : ".current.json")) {
+        return path;
+      }
+    }
+    return {};
+  }
+  void Check(std::string version, std::string origin) {
+    auto loaded = Load();
+    ASSERT_EQ(1u, loaded.size());
+    EXPECT_EQ(origin, loaded[0].recovery);
+    auto installed = Installed(loaded[0]);
+    EXPECT_EQ(version, installed->GetCurrentVersion());
+    EXPECT_EQ(Identity(), installed->GetSourceUrl());
+    SubscriptionCollectionImpl collection({installed}, "test");
+    EXPECT_TRUE(collection.FindBySubresourceFilter(
+        GURL("https://ads.recovery.invalid/ad.js"),
+        {GURL("https://recovery.invalid/")}, ContentType::Script, SiteKey(),
+        FilterCategory::Blocking));
+    EXPECT_FALSE(
+        installed->GetElemhideData(GURL("https://recovery.invalid/"), false)
+            .elemhide_selectors.empty());
+  }
+  size_t Generations() {
+    size_t count = 0;
+    base::FileEnumerator files(directory.GetPath(), false,
+                               base::FileEnumerator::FILES);
+    for (auto path = files.Next(); !path.empty(); path = files.Next()) {
+      if (path.MatchesExtension(FILE_PATH_LITERAL(".fb"))) {
+        ++count;
+      }
+    }
+    return count;
+  }
+  base::test::TaskEnvironment tasks;
+  base::ScopedTempDir directory;
+};
+
+TEST_F(ShieldsRecoveryTest, AtomicPublicationSurvivesEveryInterruptedBoundary) {
+  for (std::string boundary : {"candidate persisted", "previous published",
+                               "current published", "obsolete cleaned"}) {
+    SCOPED_TRACE(boundary);
+    ASSERT_TRUE(Commit("203001010001").data);
+    auto result =
+        Commit("203001010002",
+               base::BindLambdaForTesting([&](std::string_view reached) {
+                 return reached != boundary;
+               }));
+    EXPECT_FALSE(result.data);
+    Check(boundary == "candidate persisted" || boundary == "previous published"
+              ? "203001010001"
+              : "203001010002",
+          "current");
+    EXPECT_LE(Generations(), 2u);
+  }
+}
+TEST_F(ShieldsRecoveryTest, CorruptCurrentRecoversPreviousWithRealFiltering) {
+  ASSERT_TRUE(Commit("203001010001").data);
+  auto latest = Commit("203001010002");
+  ASSERT_TRUE(latest.data);
+  latest.data.reset();
+  tasks.RunUntilIdle();
+  ASSERT_TRUE(base::WriteFile(latest.path, "broken"));
+  Check("203001010001", "previous");
+  auto loaded = Load();
+  EXPECT_EQ(
+      "https://raw.githubusercontent.com/uazo/cromite/pages/filters/"
+      "easylist.txt",
+      loaded[0].diagnostics.last_success_source);
+  EXPECT_EQ(false, loaded[0].diagnostics.active_privileged);
+}
+TEST_F(ShieldsRecoveryTest, CorruptCurrentRecordRecoversPrevious) {
+  ASSERT_TRUE(Commit("203001010001").data);
+  ASSERT_TRUE(Commit("203001010002").data);
+  ASSERT_TRUE(base::WriteFile(Record(), "{truncated"));
+  Check("203001010001", "previous");
+}
+TEST_F(ShieldsRecoveryTest, InvalidCandidatesCannotReplaceValidData) {
+  ASSERT_TRUE(Commit("203001010001").data);
+  for (std::string bytes : {"", "<html>error</html>", "ABP2truncated"}) {
+    auto result = storage::Commit(
+        directory.GetPath(), std::make_unique<InMemoryFlatbufferData>(bytes),
+        {}, NoLegacy(), base::MakeRefCounted<storage::Permit>(true));
+    EXPECT_FALSE(result.data);
+    Check("203001010001", "current");
+  }
+}
+TEST_F(ShieldsRecoveryTest, WrongIdentityAndSchemaRecordsFallBack) {
+  ASSERT_TRUE(Commit("203001010001").data);
+  ASSERT_TRUE(Commit("203001010002").data);
+  std::string text;
+  ASSERT_TRUE(base::ReadFileToString(Record(), &text));
+  auto record = base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(record);
+  auto invalid = record->Clone();
+  invalid.Set("schema", "incompatible");
+  ASSERT_TRUE(base::JSONWriter::Write(invalid, &text));
+  ASSERT_TRUE(base::WriteFile(Record(), text));
+  Check("203001010001", "previous");
+  invalid = record->Clone();
+  invalid.Set("identity", "https://untrusted.invalid/list.txt");
+  ASSERT_TRUE(base::JSONWriter::Write(invalid, &text));
+  ASSERT_TRUE(base::WriteFile(Record(), text));
+  Check("203001010001", "previous");
+}
+TEST_F(ShieldsRecoveryTest, BothInvalidYieldsNoFalseOperationalState) {
+  ASSERT_TRUE(Commit("203001010001").data);
+  ASSERT_TRUE(Commit("203001010002").data);
+  ASSERT_TRUE(base::WriteFile(Record(), "invalid"));
+  ASSERT_TRUE(base::WriteFile(Record(true), "invalid"));
+  EXPECT_TRUE(Load().empty());
+}
+TEST_F(ShieldsRecoveryTest,
+       UnpublishedOrphanNeverActivatesOrDeletesUnownedFile) {
+  ASSERT_TRUE(Commit("203001010001").data);
+  const auto unrelated = directory.GetPath().AppendASCII("unrelated.txt");
+  ASSERT_TRUE(base::WriteFile(unrelated, "keep"));
+  EXPECT_FALSE(Commit("203001010002",
+                      base::BindLambdaForTesting([](std::string_view boundary) {
+                        return boundary != "candidate persisted";
+                      }))
+                   .data);
+  Check("203001010001", "current");
+  EXPECT_EQ(1u, Generations());
+  EXPECT_TRUE(base::PathExists(unrelated));
+}
+TEST_F(ShieldsRecoveryTest, CurrentRenameFailureRetainsOldData) {
+  ASSERT_TRUE(Commit("203001010001").data);
+  const auto path = Record();
+  auto boundary = base::BindLambdaForTesting([&](std::string_view reached) {
+    if (reached == "previous published") {
+      EXPECT_TRUE(base::DeleteFile(path));
+      EXPECT_TRUE(base::CreateDirectory(path));
+    }
+    return true;
+  });
+  EXPECT_FALSE(Commit("203001010002", boundary).data);
+  Check("203001010001", "previous");
+}
+TEST_F(ShieldsRecoveryTest, PreviousPublicationFailureRetainsCurrent) {
+  ASSERT_TRUE(Commit("203001010001").data);
+  ASSERT_TRUE(Commit("203001010002").data);
+  const auto previous = Record(true);
+  ASSERT_TRUE(base::DeleteFile(previous));
+  ASSERT_TRUE(base::CreateDirectory(previous));
+  EXPECT_FALSE(Commit("203001010003").data);
+  Check("203001010002", "current");
+}
+TEST_F(ShieldsRecoveryTest,
+       MissingStorageDirectoryFailsWithoutInventingSuccess) {
+  const auto blocked = directory.GetPath().AppendASCII("file-not-directory");
+  ASSERT_TRUE(base::WriteFile(blocked, "keep"));
+  EXPECT_FALSE(storage::Commit(blocked, Data("203001010001"), {}, NoLegacy(),
+                               base::MakeRefCounted<storage::Permit>(true))
+                   .data);
+}
+TEST_F(ShieldsRecoveryTest, CancellationBeforeAndDuringCommitPreservesCurrent) {
+  ASSERT_TRUE(Commit("203001010001").data);
+  auto permit = base::MakeRefCounted<storage::Permit>(false);
+  EXPECT_FALSE(storage::Commit(directory.GetPath(), Data("203001010002"), {},
+                               NoLegacy(), permit)
+                   .data);
+  permit->data.store(true);
+  EXPECT_FALSE(storage::Commit(
+                   directory.GetPath(), Data("203001010002"), {}, NoLegacy(),
+                   permit,
+                   base::BindLambdaForTesting([&](std::string_view boundary) {
+                     if (boundary == "previous published") {
+                       permit->data.store(false);
+                     }
+                     return true;
+                   }))
+                   .data);
+  Check("203001010001", "current");
+}
+TEST_F(ShieldsRecoveryTest, DiscardCannotRollBackNewerPublication) {
+  ASSERT_TRUE(Commit("203001010001").data);
+  auto cancelled = Commit("203001010002");
+  ASSERT_TRUE(cancelled.data);
+  auto newest = Commit("203001010003");
+  ASSERT_TRUE(newest.data);
+  storage::Remove(directory.GetPath(), Identity(), cancelled.path, true);
+  Check("203001010003", "current");
+}
+TEST_F(ShieldsRecoveryTest,
+       DiscardCurrentRestoresPreviousButUnsubscribeRemovesBoth) {
+  ASSERT_TRUE(Commit("203001010001").data);
+  auto cancelled = Commit("203001010002");
+  ASSERT_TRUE(cancelled.data);
+  storage::Remove(directory.GetPath(), Identity(), cancelled.path, true);
+  Check("203001010001", "current");
+  storage::Remove(directory.GetPath(), Identity(), cancelled.path, false);
+  EXPECT_TRUE(Load().empty());
+  EXPECT_EQ(0u, Generations());
+}
+TEST_F(ShieldsRecoveryTest, RepeatedUpdatesKeepTwoGenerationsAndLatestVersion) {
+  for (int i = 10; i < 22; ++i) {
+    ASSERT_TRUE(Commit("2030010100" + std::to_string(i)).data);
+    Check("2030010100" + std::to_string(i), "current");
+    EXPECT_LE(Generations(), 2u);
+  }
+}
+TEST_F(ShieldsRecoveryTest,
+       LegacySignatureRequiredAndFirstUpdateRetainsLegacy) {
+  const auto path =
+      directory.GetPath().AppendASCII("00000000000000000000000000000001.fb");
+  auto original = Data("203001010001");
+  ASSERT_TRUE(base::WriteFile(path, original->span()));
+  EXPECT_TRUE(Load().empty());
+  auto signature = base::BindRepeating(
+      [](const FlatbufferData&, const base::FilePath&) { return true; });
+  auto loaded = storage::Load(directory.GetPath(), signature);
+  ASSERT_EQ(1u, loaded.size());
+  EXPECT_EQ("legacy validated", loaded[0].recovery);
+  auto latest =
+      storage::Commit(directory.GetPath(), Data("203001010002"), {}, signature,
+                      base::MakeRefCounted<storage::Permit>(true));
+  ASSERT_TRUE(latest.data);
+  latest.data.reset();
+  tasks.RunUntilIdle();
+  ASSERT_TRUE(base::WriteFile(latest.path, "broken"));
+  Check("203001010001", "previous");
+  storage::Remove(directory.GetPath(), Identity(), latest.path, false);
+  EXPECT_TRUE(storage::Load(directory.GetPath(), signature).empty());
+  EXPECT_FALSE(base::PathExists(path));
+}
+TEST_F(ShieldsRecoveryTest,
+       RealPersistentStoreRecoversWithoutPreferenceSignature) {
+  TestingPrefServiceSimple prefs;
+  common::prefs::RegisterProfilePrefs(prefs.registry());
+  SubscriptionPersistentMetadataImpl metadata(&prefs);
+  auto create = [&] {
+    return std::make_unique<SubscriptionPersistentStorageImpl>(
+        directory.GetPath(),
+        std::make_unique<SubscriptionValidatorImpl>(&prefs,
+                                                    CurrentSchemaVersion()),
+        &metadata);
+  };
+  auto store = create();
+  scoped_refptr<InstalledSubscription> first, second;
+  store->StoreSubscription(Data("203001010001"),
+                           base::BindLambdaForTesting(
+                               [&](scoped_refptr<InstalledSubscription> data) {
+                                 first = std::move(data);
+                               }));
+  tasks.RunUntilIdle();
+  ASSERT_TRUE(first);
+  store->StoreSubscription(Data("203001010002"),
+                           base::BindLambdaForTesting(
+                               [&](scoped_refptr<InstalledSubscription> data) {
+                                 second = std::move(data);
+                               }));
+  tasks.RunUntilIdle();
+  ASSERT_TRUE(second);
+  store->RetireSubscription(first);
+  EXPECT_EQ(0, metadata.GetDownloadSuccessCount(Identity()));
+  first.reset();
+  second.reset();
+  store.reset();
+  tasks.RunUntilIdle();
+  EXPECT_TRUE(prefs.GetDict(common::prefs::kSubscriptionSignatures).empty());
+  store = create();
+  std::vector<scoped_refptr<InstalledSubscription>> reloaded;
+  store->LoadSubscriptions(base::BindLambdaForTesting(
+      [&](std::vector<scoped_refptr<InstalledSubscription>> loaded) {
+        reloaded = std::move(loaded);
+      }));
+  tasks.RunUntilIdle();
+  ASSERT_EQ(1u, reloaded.size());
+  EXPECT_EQ("203001010002", reloaded[0]->GetCurrentVersion());
+  EXPECT_EQ("current", metadata.GetDiagnostics(Identity()).recovery);
+  EXPECT_EQ(2u, Generations());
+}
+
+TEST_F(ShieldsRecoveryTest,
+       ProductionGuardAndRetireDiscardPreservePriorVersion) {
+  TestingPrefServiceSimple prefs;
+  common::prefs::RegisterProfilePrefs(prefs.registry());
+  SubscriptionPersistentMetadataImpl metadata(&prefs);
+  SubscriptionPersistentStorageImpl store(
+      directory.GetPath(),
+      std::make_unique<SubscriptionValidatorImpl>(&prefs,
+                                                  CurrentSchemaVersion()),
+      &metadata);
+  scoped_refptr<InstalledSubscription> first, second;
+  store.StoreSubscription(Data("203001010001"),
+                          base::BindLambdaForTesting(
+                              [&](scoped_refptr<InstalledSubscription> data) {
+                                first = std::move(data);
+                              }));
+  tasks.RunUntilIdle();
+  ASSERT_TRUE(first);
+  int callbacks = 0;
+  store.StoreSubscriptionGuarded(
+      Data("203001010002"), base::MakeRefCounted<storage::Permit>(false),
+      base::BindLambdaForTesting(
+          [&](scoped_refptr<InstalledSubscription> data) {
+            ++callbacks;
+            EXPECT_FALSE(data);
+          }));
+  tasks.RunUntilIdle();
+  EXPECT_EQ(1, callbacks);
+  Check("203001010001", "current");
+  store.StoreSubscription(Data("203001010002"),
+                          base::BindLambdaForTesting(
+                              [&](scoped_refptr<InstalledSubscription> data) {
+                                second = std::move(data);
+                              }));
+  tasks.RunUntilIdle();
+  ASSERT_TRUE(second);
+  store.RetireSubscription(first);
+  store.DiscardSubscription(second);
+  tasks.RunUntilIdle();
+  Check("203001010001", "current");
+  EXPECT_EQ(0, metadata.GetDownloadSuccessCount(Identity()));
+  EXPECT_EQ(1u, Generations());
+  EXPECT_TRUE(prefs.GetDict(common::prefs::kSubscriptionSignatures).empty());
+}
