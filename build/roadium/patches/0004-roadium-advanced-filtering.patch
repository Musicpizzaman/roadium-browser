+    FilteringConfiguration* changed_configuration) {
+  DCHECK_EQ(changed_configuration, configuration_);
+  privileged_policy_->SetEnabled(configuration_->IsPrivilegedFiltersEnabled());
+  if (!IsInitialized()) {
+    return;
+  }
+  for (const auto& url : configuration_->GetFilterLists()) {
+    if (url == CustomFiltersUrl() || !config::AllowPrivilegedFilters(url)) {
+      continue;
+    }
+    if (std::ranges::find(ongoing_installations_, url,
+                          &Subscription::GetSourceUrl) !=
+        ongoing_installations_.end()) {
+      policy_refresh_pending_.insert(url);
+    } else {
+      DownloadAndInstallSubscription(url);
+    }
+  }
+}
