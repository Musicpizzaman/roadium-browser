+scoped_refptr<InstalledSubscription> PrivilegedData(const GURL& url) {
+  auto data = base::MakeRefCounted<FlatbufferConverter>()->Convert(
+      std::vector<std::string>{
+          "||ads.example^",
+          "example.com#$#override-property-read adValue undefined",
+          "example.com##.roadiumProbe {color: #000;}"},
+      url, true);
+  return base::MakeRefCounted<InstalledSubscriptionImpl>(
+      std::move(data), Subscription::InstallationState::Installed,
+      base::Time::Now());
+}
+
+TEST(ShieldsDefaultsTest,
+     InheritedDefaultChangesWithoutOverwritingExplicitChoices) {
+  base::test::TaskEnvironment tasks;
+  TestingPrefServiceSimple prefs;
+  common::prefs::RegisterProfilePrefs(prefs.registry());
+  const auto* key = common::prefs::kAllowPrivilegedFilters;
+  EXPECT_TRUE(prefs.GetBoolean(key));
+  EXPECT_TRUE(prefs.FindPreference(key)->IsDefaultValue());
+  prefs.SetDefaultPrefValue(key, base::Value(false));
+  EXPECT_FALSE(prefs.GetBoolean(key));
+  EXPECT_EQ(nullptr, prefs.GetUserPrefValue(key));
+  prefs.SetDefaultPrefValue(key, base::Value(true));
+  EXPECT_TRUE(prefs.GetBoolean(key));
+  prefs.SetBoolean(key, false);
+  prefs.SetDefaultPrefValue(key, base::Value(true));
+  EXPECT_FALSE(prefs.GetBoolean(key));
+  EXPECT_FALSE(prefs.FindPreference(key)->IsDefaultValue());
+  prefs.SetBoolean(key, true);
+  prefs.SetDefaultPrefValue(key, base::Value(true));
+  EXPECT_TRUE(prefs.GetBoolean(key));
+}
+
+TEST(ShieldsDefaultsTest,
+     AdvancedPreferencePreservesGlobalOffAndIndependentSelections) {
+  base::test::TaskEnvironment tasks;
+  TestingPrefServiceSimple prefs;
+  common::prefs::RegisterProfilePrefs(prefs.registry());
+  PersistentFilteringConfiguration configuration(&prefs, "adblock");
+  configuration.SetEnabled(false);
+  configuration.AddFilterList(GURL("https://custom.invalid/list.txt"));
+  configuration.AddCustomFilter("||custom-ads.invalid^");
+  configuration.AddAllowedDomain("allowed.invalid");
+  const auto selected = configuration.GetFilterLists();
+  configuration.SetPrivilegedFiltersEnabled(false);
+  configuration.SetPrivilegedFiltersEnabled(true);
+  EXPECT_FALSE(configuration.IsEnabled());
+  EXPECT_EQ(selected, configuration.GetFilterLists());
+  EXPECT_EQ(std::vector<std::string>{"||custom-ads.invalid^"},
+            configuration.GetCustomFilters());
+  EXPECT_EQ(std::vector<std::string>{"allowed.invalid"},
+            configuration.GetAllowedDomains());
+}
+
+TEST(ShieldsDefaultsTest,
+     ExistingSnapshotsHonorLiveOptOutAndKeepBasicBlocking) {
+  base::test::TaskEnvironment tasks;
+  const GURL trusted(
+      "https://uazo.github.io/cromite/filters/abp-filters-anti-cv.txt");
+  auto policy = base::MakeRefCounted<PrivilegedFilterPolicy>(true);
+  SubscriptionCollectionImpl old_snapshot({PrivilegedData(trusted)}, "adblock",
+                                          policy);
+  const GURL page("https://example.com/");
+  const auto snippets = old_snapshot.GenerateSnippets(page, {});
+  ASSERT_EQ(1u, snippets.size());
+  const auto& call = snippets.front().GetList();
+  ASSERT_EQ(3u, call.size());
+  EXPECT_EQ("override-property-read", call[0].GetString());
+  EXPECT_EQ("adValue", call[1].GetString());
+  EXPECT_EQ("undefined", call[2].GetString());
+  ASSERT_FALSE(old_snapshot.GetElementHideEmulationData(page)
+                   .selectors_to_inline_css.empty());
+  policy->SetEnabled(false);
+  EXPECT_TRUE(old_snapshot.GenerateSnippets(page, {}).empty());
+  EXPECT_TRUE(old_snapshot.GetElementHideEmulationData(page)
+                  .selectors_to_inline_css.empty());
+  EXPECT_TRUE(old_snapshot
+                  .FindBySubresourceFilter(GURL("https://ads.example/ad.js"),
+                                           {page}, ContentType::Script,
+                                           SiteKey(), FilterCategory::Blocking)
+                  .has_value());
+  policy->SetEnabled(true);
+  EXPECT_FALSE(old_snapshot.GenerateSnippets(page, {}).empty());
+}
+
+TEST(ShieldsDefaultsTest, UnknownRawAliasAndManualBuffersNeverGainPrivilege) {
+  base::test::TaskEnvironment tasks;
+  const GURL page("https://example.com/");
+  auto policy = base::MakeRefCounted<PrivilegedFilterPolicy>(true);
+  for (const auto& url : {GURL("https://custom.invalid/list.txt"),
