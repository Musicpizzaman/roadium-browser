+                          CustomFiltersUrl()}) {
+    SubscriptionCollectionImpl snapshot({PrivilegedData(url)}, "adblock",
+                                        policy);
+    EXPECT_TRUE(snapshot.GenerateSnippets(page, {}).empty()) << url;
+    EXPECT_TRUE(snapshot.GetElementHideEmulationData(page)
