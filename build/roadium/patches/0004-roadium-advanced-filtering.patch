@@ -0,0 +1,28 @@
+// Copyright 2026 Roadium Browser contributors.
+// SPDX-License-Identifier: GPL-3.0-only
+#ifndef COMPONENTS_ADBLOCK_CORE_SUBSCRIPTION_PRIVILEGED_FILTER_POLICY_H_
+#define COMPONENTS_ADBLOCK_CORE_SUBSCRIPTION_PRIVILEGED_FILTER_POLICY_H_
+
+#include <atomic>
+
+#include "base/memory/ref_counted.h"
+
+namespace adblock {
+
+// Snapshots can outlive their maintainer and run on other sequences. A live
+// gate prevents cached privileged data from outliving a user's opt-out.
+class PrivilegedFilterPolicy
+    : public base::RefCountedThreadSafe<PrivilegedFilterPolicy> {
+ public:
+  explicit PrivilegedFilterPolicy(bool enabled);
+  bool IsEnabled() const { return enabled_.load(); }
+  void SetEnabled(bool enabled) { enabled_.store(enabled); }
+
+ private:
+  friend class base::RefCountedThreadSafe<PrivilegedFilterPolicy>;
+  ~PrivilegedFilterPolicy();
+  std::atomic_bool enabled_;
+};
+
+}  // namespace adblock
+#endif
