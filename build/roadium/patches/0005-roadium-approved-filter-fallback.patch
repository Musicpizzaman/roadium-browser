+ConversionResult FlatbufferConverter::ConvertForApprovedTransport(
+    std::istream& input,
+    GURL identity,
+    bool allow_privileged,
+    bool headerless_domain_list) {
+  input.seekg(0, std::ios::end);
+  const std::streamoff size = input.tellg();
+  if (size <= 0 || size > kMaximumApprovedFilterBytes) {
+    return ConversionError(
+        "Empty, unreadable or oversized approved filter list");
+  }
+  input.seekg(0, std::ios::beg);
+  std::string header;
+  std::getline(input, header);
+  if (base::StartsWith(header, "\xEF\xBB\xBF")) {
+    header.erase(0, 3);
+  }
+  base::TrimWhitespaceASCII(header, base::TRIM_ALL, &header);
+  constexpr std::string_view prefix = "[Adblock Plus ";
+  if (headerless_domain_list && base::StartsWith(header, "! Title:")) {
+    std::string first_rule;
+    while (std::getline(input, first_rule)) {
+      base::TrimWhitespaceASCII(first_rule, base::TRIM_ALL, &first_rule);
+      if (!first_rule.empty() && !base::StartsWith(first_rule, "!")) {
+        break;
+      }
+    }
+    if (!base::StartsWith(first_rule, "||") &&
+        !base::StartsWith(first_rule, "@@||")) {
+      return ConversionError(
+          "Approved headerless domain list has no initial domain rule");
+    }
+  } else {
+    if (!base::StartsWith(header, prefix) || !base::EndsWith(header, "]")) {
+      return ConversionError(
+          "Approved filter transport returned invalid plaintext header");
+    }
+    const auto version = std::string_view(header).substr(
+        prefix.size(), header.size() - prefix.size() - 1);
+    if (version.empty() || version.front() < '0' || version.front() > '9' ||
+        !std::ranges::all_of(version, [](char c) {
+          return (c >= '0' && c <= '9') || c == '.';
+        })) {
+      return ConversionError("Unsupported approved filter format");
+    }
+  }
+  input.clear();
+  input.seekg(0, std::ios::beg);
+  auto result = Convert(input, identity, allow_privileged);
+  if (absl::holds_alternative<GURL>(result)) {
+    return ConversionError(
+        "Filter-declared redirects are not allowed for approved transports");
+  }
+  if (auto* data = std::get_if<std::unique_ptr<FlatbufferData>>(&result)) {
+    if (!*data || !(*data)->data()) {
+      return ConversionError("Converter returned no data");
+    }
+    flatbuffers::Verifier verifier((*data)->data(), (*data)->size());
+    if (!flat::VerifySubscriptionBuffer(verifier)) {
+      return ConversionError("Invalid converted FlatBuffers data");
+    }
+    const auto* metadata = flat::GetSubscription((*data)->data())->metadata();
+    if (!metadata || !metadata->url() ||
+        GURL(metadata->url()->str()) != identity ||
+        !metadata->flatbuffers_schema_version() ||
+        metadata->flatbuffers_schema_version()->str() !=
+            CurrentSchemaVersion()) {
+      return ConversionError("Converted filter identity or schema mismatch");
+    }
+    const auto rules = (*data)->GetRuleStatistics();
+    if (!rules || rules->accepted <= 0) {
+      return ConversionError(
+          "Approved list contains no supported filter rules");
+    }
+  }
+  return result;
+}
