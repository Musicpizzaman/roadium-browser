+void SubscriptionDownloaderImpl::StartTransport(const GURL& identity) {
+  auto found = ongoing_downloads_.find(identity);
+  if (found == ongoing_downloads_.end()) {
+    return;
+  }
+  auto& state = found->second;
+  state.token = base::UnguessableToken::Create();
+  state.request = request_maker_.Run();
+  if (!state.request) {
+    AbortWithWarning(found, "No subscription request available");
     return;
   }
+  const auto token = state.token;
+  const bool approved = state.fallback.is_valid();
+  const GURL transport = state.fallback_used ? state.fallback : identity;
+  if (approved) {
+    state.request->SetStrictTransportPolicy();
+  }
+  state.request->SetAttemptDiagnosticCallback(
+      base::BindRepeating(&SubscriptionDownloaderImpl::OnAttemptDiagnostic,
+                          weak_ptr_factory_.GetWeakPtr(), identity, token));
+  state.request->Start(
+      transport, AdblockResourceRequest::Method::GET,
+      base::BindRepeating(&SubscriptionDownloaderImpl::OnDownloadFinished,
+                          weak_ptr_factory_.GetWeakPtr(), identity, token),
+      approved ? AdblockResourceRequest::RetryPolicy::DoNotRetry : state.policy,
+      state.fallback_used ? ""
+                          : BuildSubscriptionQueryParams(
+                                identity, persistent_metadata_, false));
+  // A synchronous terminal response can erase this request and start another.
+}
 
