+namespace adblock {
+namespace {
+scoped_refptr<net::HttpResponseHeaders> Headers(std::string_view block) {
+  return base::MakeRefCounted<net::HttpResponseHeaders>(
+      net::HttpUtil::AssembleRawHeaders(block));
+}
+class ControlledThrottle : public AdblockRequestThrottle {
+ public:
+  bool allow = true;
+  base::OnceClosure pending;
+  void RunWhenRequestsAllowed(base::OnceClosure callback) override {
+    if (allow) {
+      std::move(callback).Run();
+    } else {
+      pending = std::move(callback);
+    }
+  }
+  void AllowRequestsAfter(base::TimeDelta) override {}
+};
+
+class ShieldsTransportTest : public testing::Test {
+ public:
+  static void SetUpTestSuite() { mojo::core::Init(); }
+  static void TearDownTestSuite() { mojo::core::ShutDown(); }
+  base::test::TaskEnvironment tasks{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  net::test::ScopedMockNetworkChangeNotifier notifier;
+  network::TestURLLoaderFactory factory{true};
+  scoped_refptr<network::SharedURLLoaderFactory> shared =
+      base::MakeRefCounted<network::WeakWrapperSharedURLLoaderFactory>(
+          &factory);
+  ControlledThrottle throttle;
+  const net::BackoffEntry::Policy backoff = {0,       5000, 2.0,  0,
+                                             3600000, -1,   false};
+  std::unique_ptr<AdblockResourceRequestImpl> request;
+  const GURL url{"https://uazo.github.io/cromite/filters/easylist.txt"};
+  int finished = 0;
+  int error = net::OK;
+  base::FilePath downloaded;
+
+  void SetUp() override {
+    notifier.mock_network_change_notifier()->SetConnectionType(
+        net::NetworkChangeNotifier::CONNECTION_WIFI);
+    request = std::make_unique<AdblockResourceRequestImpl>(&backoff, shared,
+                                                           &throttle);
+    request->SetStrictTransportPolicy();
+    request->SetAttemptDiagnosticCallback(base::BindLambdaForTesting(
+        [this](const GURL&, int code, int, bool retrying) {
+          error = code;
+          EXPECT_FALSE(retrying);
+        }));
+  }
+  void TearDown() override {
+    if (!downloaded.empty()) {
+      base::DeleteFile(downloaded);
+    }
+  }
+  void Start() {
+    request->Start(url, AdblockResourceRequest::Method::GET,
+                   base::BindLambdaForTesting(
+                       [this](const GURL& source, base::FilePath file,
+                              scoped_refptr<net::HttpResponseHeaders>) {
+                         EXPECT_EQ(url, source);
+                         downloaded = std::move(file);
+                         ++finished;
+                       }),
+                   AdblockResourceRequest::RetryPolicy::RetryUntilSucceeded);
+    tasks.RunUntilIdle();
+  }
+};
+
+TEST_F(ShieldsTransportTest, DeadlineTerminatesOnceWithoutInnerRetries) {
+  Start();
+  ASSERT_EQ(1, factory.NumPending());
+  tasks.FastForwardBy(base::Seconds(kApprovedFilterAttemptTimeoutSeconds));
+  EXPECT_EQ(1, finished);
+  EXPECT_EQ(net::ERR_TIMED_OUT, error);
+  EXPECT_TRUE(downloaded.empty());
+  tasks.FastForwardBy(base::Hours(24));
+  EXPECT_EQ(1, finished);
+}
+
+TEST_F(ShieldsTransportTest,
+       ThrottleQueueIsBoundedAndReleasedStaleClosureCannotStart) {
+  throttle.allow = false;
+  Start();
+  ASSERT_TRUE(throttle.pending);
+  EXPECT_EQ(0, factory.NumPending());
+  tasks.FastForwardBy(base::Seconds(kApprovedFilterAttemptTimeoutSeconds));
+  EXPECT_EQ(1, finished);
+  EXPECT_EQ(net::ERR_TIMED_OUT, error);
+  std::move(throttle.pending).Run();
+  tasks.RunUntilIdle();
+  EXPECT_EQ(0, factory.NumPending());
+  EXPECT_EQ(1, finished);
+}
+
+TEST_F(ShieldsTransportTest, OfflineFailsImmediatelyWithoutQueuedRetry) {
+  notifier.mock_network_change_notifier()->SetConnectionType(
+      net::NetworkChangeNotifier::CONNECTION_NONE);
+  Start();
+  EXPECT_EQ(1, finished);
+  EXPECT_EQ(net::ERR_INTERNET_DISCONNECTED, error);
+  EXPECT_EQ(0, factory.NumPending());
+  tasks.FastForwardBy(base::Hours(24));
+  EXPECT_EQ(1, finished);
+}
+
+TEST_F(ShieldsTransportTest, HttpRedirectIsRejectedBeforeFollow) {
+  Start();
+  ASSERT_EQ(1, factory.NumPending());
+  auto* pending = factory.GetPendingRequest(0);
+  EXPECT_EQ(network::mojom::CredentialsMode::kOmit,
+            pending->request.credentials_mode);
+  EXPECT_EQ(network::mojom::RedirectMode::kError,
+            pending->request.redirect_mode);
+  net::RedirectInfo redirect;
+  redirect.status_code = 302;
+  redirect.new_url = GURL("https://example.com/unapproved.txt");
+  redirect.new_method = "GET";
+  auto head = network::mojom::URLResponseHead::New();
+  head->headers = Headers("HTTP/1.1 302 Found\r\n\r\n");
+  pending->client->OnReceiveRedirect(redirect, std::move(head));
+  tasks.RunUntilIdle();
+  EXPECT_EQ(1, finished);
+  EXPECT_EQ(net::ERR_UNSAFE_REDIRECT, error);
+  EXPECT_TRUE(pending->test_url_loader->follow_redirect_params().empty());
+  tasks.FastForwardBy(base::Minutes(5));
+  EXPECT_EQ(1, finished);
+}
+
+TEST_F(ShieldsTransportTest, OversizedResponseDoesNotDeliverTemporaryFile) {
+  auto head = network::mojom::URLResponseHead::New();
+  head->headers = Headers("HTTP/1.1 200 OK\r\n\r\n");
+  factory.AddResponse(url, std::move(head),
+                      std::string(kMaximumApprovedFilterBytes + 1, 'a'),
+                      network::URLLoaderCompletionStatus(net::OK));
+  Start();
+  EXPECT_EQ(1, finished);
+  EXPECT_NE(net::OK, error);
+  EXPECT_TRUE(downloaded.empty());
+}
+
+TEST_F(ShieldsTransportTest, IncompleteResponseCannotReturnPartialData) {
+  auto head = network::mojom::URLResponseHead::New();
+  head->headers = Headers("HTTP/1.1 200 OK\r\nContent-Length: 2000\r\n\r\n");
+  factory.AddResponse(
+      url, std::move(head), "[Adblock Plus 2.0]\n||ads.example^\n",
+      network::URLLoaderCompletionStatus(net::ERR_CONTENT_LENGTH_MISMATCH));
+  Start();
+  EXPECT_EQ(1, finished);
+  EXPECT_EQ(net::ERR_CONTENT_LENGTH_MISMATCH, error);
+  EXPECT_TRUE(downloaded.empty());
+}
+
+TEST_F(ShieldsTransportTest,
+       DestructionCancelsDeadlineAndPendingNetworkResponse) {
+  Start();
+  request.reset();
+  tasks.FastForwardBy(base::Hours(24));
+  EXPECT_EQ(0, finished);
+}
