 void SubscriptionDownloaderImpl::AbortWithWarning(
-    const OngoingDownloadsIt ongoing_download_it,
-    const std::string& warning) {
-  if (ongoing_download_it == ongoing_downloads_.end()) {
+    const OngoingDownloadsIt found,
+    const std::string& warning,
+    bool allow_fallback) {
+  if (found == ongoing_downloads_.end()) {
+    return;
+  }
+  const GURL identity = found->first;
+  if (allow_fallback && TryFallback(identity, warning)) {
     return;
   }
-  auto diagnostic = persistent_metadata_->GetDiagnostics(ongoing_download_it->first);
+  auto diagnostic = persistent_metadata_->GetDiagnostics(identity);
   diagnostic.stage = DiagnosticStage::Failed;
-  diagnostic.error = "Conversion/redirect: " + warning;
-  persistent_metadata_->SetDiagnostics(ongoing_download_it->first, diagnostic);
-  LOG(WARNING) << "[eyeo] " << warning << " Aborting download of "
-                << ongoing_download_it->first;
-  auto callback = std::move(
-      std::get<DownloadCompletedCallback>(ongoing_download_it->second));
-  ongoing_downloads_.erase(ongoing_download_it);
+  diagnostic.error = warning;
+  if (diagnostic.fallback_attempted) {
+    diagnostic.fallback_outcome = "failed";
+  }
+  persistent_metadata_->SetDiagnostics(identity, diagnostic);
+  // Count one logical failed update, not one failure per transport. A
+  // preference change invalidates a conversion without becoming a network
+  // failure count.
+  if (allow_fallback) {
+    persistent_metadata_->IncrementDownloadErrorCount(identity);
+  }
+  auto callback = std::move(found->second.callback);
+  ongoing_downloads_.erase(found);
   std::move(callback).Run(nullptr);
 }
 
