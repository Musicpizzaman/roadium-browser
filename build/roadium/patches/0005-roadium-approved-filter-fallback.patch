+class ShieldsFallbackTest : public ShieldsLifecycleTest {
+ public:
+  Resource* request = nullptr;
+  int transports = 0;
+  int finished = 0;
+  std::unique_ptr<FlatbufferData> received;
+  std::unique_ptr<SubscriptionDownloaderImpl> downloader;
+
+  void SetUp() override {
+    ShieldsLifecycleTest::SetUp();
+    downloader = std::make_unique<SubscriptionDownloaderImpl>(
+        base::BindLambdaForTesting(
+            [this]() -> std::unique_ptr<AdblockResourceRequest> {
+              auto resource = std::make_unique<Resource>();
+              request = resource.get();
+              ++transports;
+              return resource;
+            }),
+        &conversion, metadata.get());
+  }
+  void Start(const GURL& url = TestUrl()) {
+    downloader->StartDownload(
+        url, AdblockResourceRequest::RetryPolicy::RetryUntilSucceeded,
+        base::BindLambdaForTesting(
+            [this](std::unique_ptr<FlatbufferData> data) {
+              received = std::move(data);
+              ++finished;
+            }));
+  }
+  void Convert(size_t index, const GURL& identity = TestUrl()) {
+    ASSERT_LT(index, conversion.callbacks.size());
+    std::move(conversion.callbacks[index]).Run(Data(identity));
+  }
+};
+
+TEST_F(ShieldsFallbackTest, PrimarySuccessDoesNotRequestFallback) {
+  Start();
+  EXPECT_TRUE(request->UsesStrictTransportPolicy());
+  EXPECT_EQ(AdblockResourceRequest::RetryPolicy::DoNotRetry, request->policy);
+  request->Deliver();
+  Convert(0);
+  EXPECT_EQ(1, transports);
+  EXPECT_EQ(1, finished);
+  ASSERT_TRUE(received);
+  EXPECT_FALSE(metadata->GetDiagnostics(TestUrl()).fallback_attempted);
+  EXPECT_EQ(TestUrl(), conversion.identities[0]);
+}
+
+TEST_F(ShieldsFallbackTest, HttpFailureUsesOneFallbackWithCanonicalIdentity) {
+  Start(TrustedUrl());
+  request->FailHttp();
+  EXPECT_EQ(0, finished);
+  EXPECT_EQ(2, transports);
+  EXPECT_EQ(config::GetApprovedFallbackTransport(TrustedUrl()), request->url);
+  EXPECT_TRUE(request->UsesStrictTransportPolicy());
+  EXPECT_EQ(AdblockResourceRequest::RetryPolicy::DoNotRetry, request->policy);
+  request->Deliver();
+  EXPECT_EQ(TrustedUrl(), conversion.identities[0]);
+  EXPECT_TRUE(conversion.privileges[0]);
+  Convert(0, TrustedUrl());
+  EXPECT_EQ(1, finished);
+  ASSERT_TRUE(received);
+  const auto d = metadata->GetDiagnostics(TrustedUrl());
+  EXPECT_EQ("HTTP 404", d.primary_failure);
+  EXPECT_EQ("parsed; awaiting storage", d.fallback_outcome);
+  EXPECT_EQ(config::GetApprovedFallbackTransport(TrustedUrl()).spec(),
+            d.source);
+  EXPECT_TRUE(d.last_success.is_null());
+  EXPECT_EQ(0, metadata->GetDownloadErrorCount(TrustedUrl()));
+}
+
+TEST_F(ShieldsFallbackTest,
+       BothTransportsFailOnceAndNextUpdateStartsAtPrimary) {
+  Start();
+  request->FailHttp();
+  request->FailHttp();
+  EXPECT_EQ(2, transports);
+  EXPECT_EQ(1, finished);
+  EXPECT_FALSE(received);
+  EXPECT_EQ(1, metadata->GetDownloadErrorCount(TestUrl()));
+  tasks.FastForwardBy(base::Hours(24));
+  EXPECT_EQ(2, transports);
+  Start();
+  EXPECT_EQ(TestUrl(), request->url);
+  EXPECT_FALSE(metadata->GetDiagnostics(TestUrl()).fallback_attempted);
+  EXPECT_TRUE(metadata->GetDiagnostics(TestUrl()).primary_failure.empty());
+}
+
+TEST_F(ShieldsFallbackTest,
+       StalePrimaryCannotConvertAndItsTemporaryFileIsRemoved) {
+  Start();
+  auto stale = request->response;
+  request->FailHttp();
+  base::ScopedTempDir temporary;
+  ASSERT_TRUE(temporary.CreateUniqueTempDir());
+  const auto file = temporary.GetPath().AppendASCII("owned-stale.txt");
+  ASSERT_TRUE(base::WriteFile(file, "owned fixture"));
+  stale.Run(TestUrl(), file, Headers("HTTP/1.1 200 OK\r\n\r\n"));
+  tasks.RunUntilIdle();
