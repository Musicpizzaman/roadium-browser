diff --git a/components/adblock/core/resources/roadium/test_verify_inputs.py b/components/adblock/core/resources/roadium/test_verify_inputs.py
new file mode 100644
index 0000000..39eeb60
--- /dev/null
+++ b/components/adblock/core/resources/roadium/test_verify_inputs.py
@@ -0,0 +1,82 @@
+# Copyright 2026 Roadium Browser contributors.
+# SPDX-License-Identifier: GPL-3.0-only
+import copy
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+from verify_inputs import merge, verify
+
+
+class FrozenFilterTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.manifest = {'format': 1, 'inputs': [], 'notices_sha256': hashlib.sha256(b'GPL3').hexdigest()}
+        (self.root / 'NOTICES.txt').write_bytes(b'GPL3')
+        for name in ('easylist.txt.gz', 'abp-filters-anti-cv.txt.gz'):
+            data = b'[Adblock Plus 2.0]\n! Version: 1\n||ads.example^\n'
+            packed = gzip.compress(data, mtime=0)
+            (self.root / name).write_bytes(packed)
+            self.manifest['inputs'].append({'file': name, 'bytes': len(data),
+                'sha256': hashlib.sha256(data).hexdigest(), 'gzip_bytes': len(packed),
+                'gzip_sha256': hashlib.sha256(packed).hexdigest(), 'version': '1',
+                'canonical_url': 'https://uazo.github.io/cromite/filters/' + name[:-3]})
+        self.save()
+
+    def save(self):
+        (self.root / 'manifest.json').write_text(json.dumps(self.manifest))
+
+    def test_exact_inputs_pass(self):
+        self.assertEqual(verify(self.root), self.manifest)
+
+    def test_missing_file_fails_without_download(self):
+        (self.root / 'easylist.txt.gz').unlink()
+        with self.assertRaises(FileNotFoundError): verify(self.root)
+
+    def test_corrupt_gzip_fails_checksum_before_decompression(self):
+        (self.root / 'easylist.txt.gz').write_bytes(b'bad')
+        with self.assertRaisesRegex(ValueError, 'checksum mismatch'): verify(self.root)
+
+    def test_wrong_text_hash_fails(self):
+        self.manifest['inputs'][0]['sha256'] = '0' * 64
+        self.save()
+        with self.assertRaisesRegex(ValueError, 'Uncompressed filter checksum'): verify(self.root)
+
+    def test_traversal_or_extra_input_fails(self):
+        self.manifest['inputs'][0]['file'] = '../easylist.txt.gz'
+        self.save()
+        with self.assertRaisesRegex(ValueError, 'exactly the frozen'): verify(self.root)
+
+    def test_identity_alias_fails(self):
+        self.manifest['inputs'][0]['canonical_url'] += '?trusted=true'
+        self.save()
+        with self.assertRaisesRegex(ValueError, 'canonical bundle identity'): verify(self.root)
+
+    def test_oversize_declaration_fails(self):
+        self.manifest['inputs'][0]['bytes'] = 33 * 1024 * 1024
+        self.save()
+        with self.assertRaisesRegex(ValueError, 'Invalid frozen input size'): verify(self.root)
+
+    def test_notices_are_verified(self):
+        (self.root / 'NOTICES.txt').write_bytes(b'missing notice')
+        with self.assertRaisesRegex(ValueError, 'notice checksum'): verify(self.root)
+
+    def test_conversion_identity_and_rule_plausibility_are_checked(self):
+        for item, name in zip(self.manifest['inputs'], ('easylist.fb', 'anticv.fb')):
+            (self.root / name).write_bytes(b'conversion stand-in; real native converter validates wire format')
+            report = {'url': item['canonical_url'], 'version': item['version'], 'rules': {'accepted': 1}}
+            (self.root / (name + '.json')).write_text(json.dumps(report))
+        first = merge(self.root, self.root)
+        self.assertEqual(first, merge(self.root, self.root))
+        report['rules']['accepted'] = 0
+        (self.root / 'anticv.fb.json').write_text(json.dumps(report))
+        with self.assertRaisesRegex(ValueError, 'no accepted rules'): merge(self.root, self.root)
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/components/adblock/core/resources/roadium/verify_inputs.py b/components/adblock/core/resources/roadium/verify_inputs.py
new file mode 100644
index 0000000..611fb5a
--- /dev/null
+++ b/components/adblock/core/resources/roadium/verify_inputs.py
@@ -0,0 +1,74 @@
+#!/usr/bin/env python3
+# Copyright 2026 Roadium Browser contributors.
+# SPDX-License-Identifier: GPL-3.0-only
+"""Verify frozen bytes before conversion; merge deterministic converter evidence."""
+import argparse
+import gzip
+import hashlib
+import json
+from pathlib import Path
+
+NAMES = {'easylist.txt.gz': 'easylist.fb',
+         'abp-filters-anti-cv.txt.gz': 'anticv.fb'}
+MAX_BYTES = 32 * 1024 * 1024
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def verify(root):
+    manifest = json.loads((root / 'manifest.json').read_text())
+    entries = manifest['inputs']
+    if len(entries) != 2 or {item['file'] for item in entries} != set(NAMES):
+        raise ValueError('Expected exactly the frozen EasyList and anti-circumvention inputs')
+    for item in entries:
+        name = item['file']
+        packed = (root / name).read_bytes()
+        if len(packed) != item['gzip_bytes'] or digest(packed) != item['gzip_sha256']:
+            raise ValueError(f'Frozen filter input checksum mismatch: {name}')
+        if not 0 < item['bytes'] <= MAX_BYTES:
+            raise ValueError(f'Invalid frozen input size: {name}')
+        with gzip.open(root / name, 'rb') as stream:
+            data = stream.read(item['bytes'] + 1)
+        if len(data) != item['bytes'] or digest(data) != item['sha256']:
+            raise ValueError(f'Uncompressed filter checksum mismatch: {name}')
+        expected = 'https://uazo.github.io/cromite/filters/' + name.removesuffix('.gz')
+        if item['canonical_url'] != expected:
+            raise ValueError(f'Wrong canonical bundle identity: {name}')
+    if digest((root / 'NOTICES.txt').read_bytes()) != manifest['notices_sha256']:
+        raise ValueError('Bundled filter notice checksum mismatch')
+    return manifest
+
+
+def merge(root, converted):
+    manifest = verify(root)
+    for item in manifest['inputs']:
+        name = NAMES[item['file']]
+        report = json.loads((converted / (name + '.json')).read_text())
+        if report['url'] != item['canonical_url'] or report['version'] != item['version']:
+            raise ValueError(f'Converted bundle identity/version mismatch: {name}')
+        if report['rules']['accepted'] <= 0:
+            raise ValueError(f'Converted bundle contains no accepted rules: {name}')
+        data = (converted / name).read_bytes()
+        item.update(rule_statistics=report['rules'], flatbuffer_bytes=len(data),
+                    flatbuffer_sha256=digest(data))
+    return manifest
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--root', type=Path, required=True)
+    parser.add_argument('--converted', type=Path)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    try:
+        result = merge(args.root, args.converted) if args.converted else verify(args.root)
+    except (OSError, ValueError, KeyError, TypeError, EOFError) as error:
+        parser.exit(1, f'Frozen Roadium filter verification failed: {error}\n')
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, sort_keys=True, indent=2) + '\n')
+
+
+if __name__ == '__main__':
+    main()
