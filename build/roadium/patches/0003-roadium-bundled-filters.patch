+std::unique_ptr<FlatbufferData> ResourceData(int id) {
+  for (const auto& info : config::GetPreloadedSubscriptionConfiguration()) {
+    if (info.flatbuffer_resource_id == id) {
+      return base::MakeRefCounted<FlatbufferConverter>()->Convert(
+          std::vector<std::string>{"||ads.example^"}, GURL(info.url_pattern),
+          false);
+    }
+  }
+  return nullptr;
+}
+
+TEST(ShieldsBundlesTest, SelectedMissingDataSurvivesWithoutPendingDownload) {
+  base::test::TaskEnvironment tasks;
+  const GURL url("https://uazo.github.io/cromite/filters/easylist.txt");
+  PreloadedSubscriptionProviderImpl provider(
+      base::BindRepeating(&ResourceData));
+  provider.UpdateSubscriptions({}, {url});
+  auto subs = provider.GetCurrentPreloadedSubscriptions();
+  ASSERT_EQ(1u, subs.size());
+  EXPECT_EQ(url, subs.front()->GetSourceUrl());
+  EXPECT_EQ(Subscription::InstallationState::Preloaded,
+            subs.front()->GetInstallationState());
+  provider.UpdateSubscriptions({}, {url});
+  ASSERT_EQ(1u, provider.GetCurrentPreloadedSubscriptions().size());
+  EXPECT_EQ(subs.front(), provider.GetCurrentPreloadedSubscriptions().front());
+}
+
+TEST(ShieldsBundlesTest, InstalledDataTakesPrecedenceAndOptOutIsRespected) {
+  base::test::TaskEnvironment tasks;
+  const GURL url(
+      "https://uazo.github.io/cromite/filters/abp-filters-anti-cv.txt");
+  PreloadedSubscriptionProviderImpl provider(
+      base::BindRepeating(&ResourceData));
+  provider.UpdateSubscriptions({url}, {url});
+  EXPECT_TRUE(provider.GetCurrentPreloadedSubscriptions().empty());
+  provider.UpdateSubscriptions({}, {url});
+  ASSERT_EQ(1u, provider.GetCurrentPreloadedSubscriptions().size());
+  provider.UpdateSubscriptions({}, {});
+  EXPECT_TRUE(provider.GetCurrentPreloadedSubscriptions().empty());
+}
+
+TEST(ShieldsBundlesTest, SimilarUntrustedIdentityDoesNotGetBundledData) {
+  base::test::TaskEnvironment tasks;
+  PreloadedSubscriptionProviderImpl provider(
+      base::BindRepeating(&ResourceData));
+  provider.UpdateSubscriptions(
+      {},
+      {GURL("https://untrusted.invalid/easylist.txt"),
+       GURL("https://uazo.github.io/cromite/filters/easylist.txt?extra=1")});
+  EXPECT_TRUE(provider.GetCurrentPreloadedSubscriptions().empty());
+}
+
+TEST(ShieldsBundlesTest, CorruptOrWrongIdentityResourceNeverBecomesActive) {
+  base::test::TaskEnvironment tasks;
+  const GURL url("https://uazo.github.io/cromite/filters/easylist.txt");
+  PreloadedSubscriptionProviderImpl corrupt(
+      base::BindRepeating([](int) -> std::unique_ptr<FlatbufferData> {
+        return std::make_unique<InMemoryFlatbufferData>("not a FlatBuffer");
+      }));
+  corrupt.UpdateSubscriptions({}, {url});
+  EXPECT_TRUE(corrupt.GetCurrentPreloadedSubscriptions().empty());
+  PreloadedSubscriptionProviderImpl wrong(base::BindRepeating([](int) {
+    return base::MakeRefCounted<FlatbufferConverter>()->Convert(
+        std::vector<std::string>{"||ads.example^"},
+        GURL("https://untrusted.invalid/list.txt"), false);
+  }));
+  wrong.UpdateSubscriptions({}, {url});
+  EXPECT_TRUE(wrong.GetCurrentPreloadedSubscriptions().empty());
+}
