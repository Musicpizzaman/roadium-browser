@@ -0,0 +1,225 @@
+// Copyright 2026 Roadium Browser contributors.
+// SPDX-License-Identifier: GPL-3.0-only
+#include <iostream>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/json/json_writer.h"
+#include "base/test/task_environment.h"
+#include "base/values.h"
+#include "components/adblock/core/common/adblock_prefs.h"
+#include "components/adblock/core/configuration/persistent_filtering_configuration.h"
+#include "components/adblock/core/converter/flatbuffer_converter.h"
+#include "components/adblock/core/converter/parser/snippet_filter.h"
+#include "components/adblock/core/subscription/installed_subscription_impl.h"
+#include "components/adblock/core/subscription/subscription_collection_impl.h"
+#include "components/adblock/core/subscription/subscription_config.h"
+#include "components/adblock/test/shields_youtube_rules.inc"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace adblock {
+namespace {
+constexpr char kTrusted[] =
+    "https://uazo.github.io/cromite/filters/abp-filters-anti-cv.txt";
+constexpr const char* kPages[] = {
+    "https://www.youtube.com/watch?v=fixture",
+    "https://m.youtube.com/watch?v=fixture",
+    "https://music.youtube.com/",
+    "https://www.youtubekids.com/",
+    "https://www.youtube-nocookie.com/embed/fixture",
+    "https://www.youtube.com/shorts/fixture",
+    "https://www.youtube.com/embed/fixture",
+    "https://unrelated.invalid/"};
+
+base::DictValue Statistics(const RuleStatistics& value) {
+  return base::DictValue()
+      .Set("accepted", value.accepted)
+      .Set("parser_rejected", value.parser_rejected)
+      .Set("unsupported_commands", value.unsupported_commands)
+      .Set("prohibited_privilege", value.prohibited_privilege)
+      .Set("unsafe_arguments", value.unsafe_arguments)
+      .Set("unsupported_options", value.unsupported_options);
+}
+
+std::unique_ptr<FlatbufferData> Convert(const std::string& rule,
+                                        bool privileged,
+                                        const GURL& url = GURL(kTrusted)) {
+  return base::MakeRefCounted<FlatbufferConverter>()->Convert(
+      std::vector<std::string>{rule}, url, privileged);
+}
+
+class ShieldsYoutubeInventoryTest : public testing::TestWithParam<int> {};
+
+TEST_P(ShieldsYoutubeInventoryTest, ActualConverterAndCurrentPolicy) {
+  base::test::TaskEnvironment tasks;
+  const auto& row = base::span(kYoutubeAuditRules)[GetParam()];
+  SCOPED_TRACE(row.id);
+  auto data = Convert(row.rule, true, GURL(row.url));
+  ASSERT_TRUE(data);
+  const auto statistics = data->GetRuleStatistics();
+  ASSERT_TRUE(statistics);
+  EXPECT_EQ(1, statistics->accepted + statistics->parser_rejected +
+                   statistics->unsupported_commands +
+                   statistics->prohibited_privilege +
+                   statistics->unsafe_arguments +
+                   statistics->unsupported_options);
+  auto denied = Convert(row.rule, false, GURL(row.url));
+  ASSERT_TRUE(denied->GetRuleStatistics());
+  base::DictValue result;
+  result.Set("id", row.id);
+  result.Set("rule", row.rule);
+  result.Set("url", row.url);
+  result.Set("source_privileged_allowed",
+             config::AllowPrivilegedFilters(GURL(row.url)));
+  result.Set("converter_privileged", Statistics(*statistics));
+  result.Set("converter_unprivileged",
+             Statistics(*denied->GetRuleStatistics()));
+  auto policy = base::MakeRefCounted<PrivilegedFilterPolicy>(true);
+  auto subscription = base::MakeRefCounted<InstalledSubscriptionImpl>(
+      std::move(data), Subscription::InstallationState::Installed,
+      base::Time::Now());
+  SubscriptionCollectionImpl snapshot({subscription}, "adblock", policy);
+  base::DictValue pages;
+  for (const char* page : kPages) {
+    auto calls = snapshot.GenerateSnippets(GURL(page), {});
+    base::ListValue list;
+    for (const auto& call : calls) {
+      list.Append(call.Clone());
+    }
+    pages.Set(page, std::move(list));
+  }
+  result.Set("actual_calls_by_document", std::move(pages));
+  policy->SetEnabled(false);
+  for (const char* page : kPages) {
+    EXPECT_TRUE(snapshot.GenerateSnippets(GURL(page), {}).empty());
+  }
+  result.Set("live_advanced_off_empty", true);
+  std::cout << "ROADIUM_YOUTUBE_AUDIT " << *base::WriteJson(result)
+            << std::endl;
+}
+
+INSTANTIATE_TEST_SUITE_P(
+    Frozen,
+    ShieldsYoutubeInventoryTest,
+    testing::Range(0, static_cast<int>(std::size(kYoutubeAuditRules))));
+
+TEST(ShieldsYoutubeTest, UnsupportedCompoundNeverPartiallyInstalls) {
+  base::test::TaskEnvironment tasks;
+  for (const auto& script :
+       {"skip-video 'video' './/div'; simulate-mouse-event 'button'",
+        "race start; skip-video 'video' './/div'; race stop; "
+        "simulate-mouse-event 'button'",
+        "override-property-read probe undefined; unknown-command",
+        "simulate-mouse-event 'button'"}) {
+    auto data = Convert(std::string("www.youtube.com#$#") + script, true);
+    ASSERT_TRUE(data->GetRuleStatistics());
+    EXPECT_EQ(0, data->GetRuleStatistics()->accepted);
+    EXPECT_EQ(1, data->GetRuleStatistics()->unsupported_commands);
+    auto installed = base::MakeRefCounted<InstalledSubscriptionImpl>(
+        std::move(data), Subscription::InstallationState::Installed,
+        base::Time::Now());
+    SubscriptionCollectionImpl snapshot(
+        {installed}, "adblock",
+        base::MakeRefCounted<PrivilegedFilterPolicy>(true));
+    EXPECT_TRUE(snapshot.GenerateSnippets(GURL(kPages[0]), {}).empty());
+  }
+}
+
+TEST(ShieldsYoutubeTest, OverrideArgumentsRejectWholeRule) {
+  for (const auto& script :
+       {"override-property-read", "override-property-read path",
+        "override-property-read path arbitraryJavascript",
+        "override-property-read path undefined bad"}) {
+    auto data = Convert(
+        std::string("www.youtube.com#$#json-prune 'playerAds'; ") + script,
+        true);
+    EXPECT_EQ(0, data->GetRuleStatistics()->accepted);
+    EXPECT_EQ(1, data->GetRuleStatistics()->unsafe_arguments);
+  }
+  auto broken = Convert("www.youtube.com#$#json-prune 'unterminated", true);
+  EXPECT_EQ(1, broken->GetRuleStatistics()->parser_rejected);
+}
+
+TEST(ShieldsYoutubeTest, YoutubeIdentityAndLiveOptOut) {
+  base::test::TaskEnvironment tasks;
+  const char* rule =
+      "www.youtube.com,m.youtube.com#$#json-prune 'playerAds'; "
+      "override-property-read ytInitialPlayerResponse.adPlacements undefined";
+  for (const auto& url :
+       {GURL(kTrusted),
+        GURL("https://raw.githubusercontent.com/uazo/cromite/master/tools/"
+             "filters/experimental-cromite-filters.txt"),
+        GURL("https://custom.invalid/copied.txt"),
+        GURL("https://raw.githubusercontent.com/uazo/cromite/pages/filters/"
+             "abp-filters-anti-cv.txt")}) {
+    auto data = Convert(rule, true, url);
+    auto installed = base::MakeRefCounted<InstalledSubscriptionImpl>(
+        std::move(data), Subscription::InstallationState::Installed,
+        base::Time::Now());
+    auto policy = base::MakeRefCounted<PrivilegedFilterPolicy>(true);
+    SubscriptionCollectionImpl snapshot({installed}, "adblock", policy);
+    const bool trusted =
+        url == GURL(kTrusted) ||
+        url.path().ends_with("experimental-cromite-filters.txt");
+    EXPECT_EQ(trusted ? 2u : 0u,
+              snapshot.GenerateSnippets(GURL(kPages[0]), {}).size());
+    EXPECT_TRUE(snapshot.GenerateSnippets(GURL(kPages[7]), {}).empty());
+    policy->SetEnabled(false);
+    EXPECT_TRUE(snapshot.GenerateSnippets(GURL(kPages[0]), {}).empty());
+  }
+}
+
+TEST(ShieldsYoutubeTest, MaintainedDefaultAndExplicitExperimentalOptIn) {
+  const GURL experimental(
+      "https://raw.githubusercontent.com/uazo/cromite/master/"
+      "tools/filters/experimental-cromite-filters.txt");
+  int experimental_count = 0;
+  int maintained_count = 0;
+  for (const auto& subscription : config::GetKnownSubscriptions()) {
+    if (subscription.url == experimental) {
+      ++experimental_count;
+      EXPECT_EQ(SubscriptionFirstRunBehavior::Ignore, subscription.first_run);
+      EXPECT_EQ(SubscriptionUiVisibility::Visible, subscription.ui_visibility);
+      EXPECT_EQ(SubscriptionPrivilegedFilterStatus::AllowedAndChecked,
+                subscription.privileged_status);
+    }
+    if (subscription.url == AntiCVUrl()) {
+      ++maintained_count;
+      EXPECT_EQ(SubscriptionFirstRunBehavior::SubscribeAtFirstRun,
+                subscription.first_run);
+      EXPECT_TRUE(config::AllowPrivilegedFilters(subscription.url));
+    }
+  }
+  EXPECT_EQ(1, experimental_count);
+  EXPECT_EQ(1, maintained_count);
+  EXPECT_TRUE(config::AllowPrivilegedFilters(experimental));
+}
+
+TEST(ShieldsYoutubeTest, ExistingSelectionAndOptOutSurviveRecreation) {
+  base::test::TaskEnvironment tasks;
+  TestingPrefServiceSimple prefs;
+  common::prefs::RegisterProfilePrefs(prefs.registry());
+  const GURL experimental(
+      "https://raw.githubusercontent.com/uazo/cromite/master/"
+      "tools/filters/experimental-cromite-filters.txt");
+  {
+    PersistentFilteringConfiguration existing(&prefs, "adblock");
+    existing.AddFilterList(experimental);
+    existing.AddCustomFilter("||manual.invalid^");
+    existing.SetPrivilegedFiltersEnabled(false);
+  }
+  {
+    PersistentFilteringConfiguration restored(&prefs, "adblock");
+    EXPECT_TRUE(restored.IsFilterListPresent(experimental));
+    EXPECT_FALSE(restored.IsPrivilegedFiltersEnabled());
+    EXPECT_EQ(std::vector<std::string>{"||manual.invalid^"},
+              restored.GetCustomFilters());
+    restored.RemoveFilterList(experimental);
+  }
+  PersistentFilteringConfiguration opted_out(&prefs, "adblock");
+  EXPECT_FALSE(opted_out.IsFilterListPresent(experimental));
+  EXPECT_FALSE(opted_out.IsPrivilegedFiltersEnabled());
+}
+}  // namespace
+}  // namespace adblock
