+TEST_F(ShieldsLifecycleTest, MetadataSurvivesReloadAndMarksInterruptedAttempts) {
+  SubscriptionDiagnostics d;
+  d.stage = DiagnosticStage::Parsed;
+  d.downloaded = true;
+  d.parsed = true;
+  d.last_success = base::Time::Now() - base::Hours(1);
+  d.error = std::string(1000, 'e');
+  d.source = std::string(4000, 's');
+  d.rules = RuleStatistics{};
+  d.rules->unsupported_commands = 7;
+  metadata->SetDiagnostics(TestUrl(), d);
+  metadata->IncrementDownloadSuccessCount(TestUrl());
+  metadata->IncrementDownloadSuccessCount(TestUrl());
+  metadata->IncrementDownloadErrorCount(TestUrl());
+  SubscriptionPersistentMetadataImpl reloaded(&prefs);
+  const auto saved = reloaded.GetDiagnostics(TestUrl());
+  EXPECT_EQ(DiagnosticStage::Interrupted, saved.stage);
+  EXPECT_EQ(d.last_success, saved.last_success);
+  EXPECT_EQ(2048u, saved.source.size());
+  ASSERT_TRUE(saved.rules);
+  EXPECT_EQ(7, saved.rules->unsupported_commands);
+  EXPECT_EQ(2, reloaded.GetDownloadSuccessCount(TestUrl()));
+  EXPECT_EQ(1, reloaded.GetDownloadErrorCount(TestUrl()));
+  EXPECT_FALSE(prefs.GetBoolean(common::prefs::kAllowPrivilegedFilters));
