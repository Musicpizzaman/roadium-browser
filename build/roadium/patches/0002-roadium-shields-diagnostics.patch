+void FilteringConfigurationMaintainerImpl::StartUpdateWithCallback(
+    base::OnceCallback<void(UpdateCheckResult)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  FinishAllManual(ManualOutcome::Cancelled);
+  manual_result_ = {};
+  auto urls = configuration_->GetFilterLists();
+  manual_pending_ = std::set<GURL>(urls.begin(), urls.end());
+  manual_result_.checked = static_cast<int>(manual_pending_.size());
+  manual_callback_ = std::move(callback);
+  if (manual_pending_.empty()) {
+    std::move(manual_callback_).Run(manual_result_);
+    return;
