+                .put("version", "previous").put("stage", 5).put("error", "HTTP 404")
+                .put("successful_requests", 12).put("consecutive_failures", 3));
+        String description = new ShieldsDiagnostics(data.toString())
+                .describeSubscription(new URL("https://example.com/easylist.txt"));
+        assertTrue(description.contains("loaded in the active engine"));
+        assertTrue(description.contains("Loaded version: previous"));
