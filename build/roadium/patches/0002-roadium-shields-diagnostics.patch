+                .put("url", "https://example.com/easylist.txt").put("active", true));
+        String text = new ShieldsDiagnostics(data.toString())
+                .describeSubscription(new URL("https://example.com/easylist.txt"));
+        assertTrue(text.contains("downloaded not recorded, parsed not recorded"));
+        assertTrue(text.contains("Latest conversion counts: not recorded"));
+    }
+
+    @Test public void manualBatchShowsActualMixedResultAndTimeout() throws Exception {
+        JSONObject data = snapshot();
+        JSONObject update = new JSONObject().put("batch_id", 4).put("checked", 4)
+                .put("updated", 1).put("failed", 1).put("cancelled", 1).put("timed_out", 1);
+        data.put("update", update);
