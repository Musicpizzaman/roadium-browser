+
+void FilteringConfigurationMaintainerImpl::FinishManual(
+    const GURL& url, ManualOutcome outcome) {
+  if (!manual_pending_.erase(url)) return;
+  UpdateCheckEntry entry;
+  entry.url = url.SchemeIs("data") ? "Inline subscription (contents omitted)" : url.spec();
+  entry.configuration = configuration_->GetName();
+  entry.outcome = static_cast<int>(outcome);
+  const auto diagnostic = persistent_metadata_->GetDiagnostics(url);
+  if (outcome == ManualOutcome::Failed)
+    entry.error = diagnostic.error.empty() ? "No valid update data received" : diagnostic.error;
+  if (outcome == ManualOutcome::Cancelled)
+    entry.error = "Subscription or configuration stopped before activation";
+  if (outcome == ManualOutcome::TimedOut)
+    entry.error = "Check timed out after 45 seconds; the subscription update may continue";
+  manual_result_.entries.push_back(std::move(entry));
+  switch (outcome) {
+    case ManualOutcome::Updated: ++manual_result_.updated; break;
+    case ManualOutcome::Failed: ++manual_result_.failed; break;
+    case ManualOutcome::Cancelled: ++manual_result_.cancelled; break;
+    case ManualOutcome::TimedOut: ++manual_result_.timed_out; break;
+  }
+  if (manual_pending_.empty() && manual_callback_) {
+    manual_deadline_.Stop();
+    std::move(manual_callback_).Run(manual_result_);
+  }
+}
+
+void FilteringConfigurationMaintainerImpl::FinishAllManual(ManualOutcome outcome) {
+  auto pending = manual_pending_;
+  for (const auto& url : pending) FinishManual(url, outcome);
 }
 
