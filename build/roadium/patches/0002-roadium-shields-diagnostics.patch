+void SubscriptionServiceImpl::StartUpdateCheck() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (manual_result_.running) return;  // Repeated taps join the same batch.
+  manual_result_ = {};
+  next_batch_id_ = next_batch_id_ == std::numeric_limits<int>::max() ? 1 : next_batch_id_ + 1;
+  manual_result_.batch_id = next_batch_id_;
+  manual_pending_configurations_ = 0;
+  for (const auto& entry : maintainers_) {
+    if (entry.second) {
+      ++manual_pending_configurations_;
+    }
+  }
+  manual_result_.running = manual_pending_configurations_ != 0;
+  const int batch_id = manual_result_.batch_id;
+  for (auto& entry : maintainers_) {
+    if (entry.second) entry.second->StartUpdateWithCallback(
+        base::BindOnce(&SubscriptionServiceImpl::OnManualCheckFinished,
+                       weak_ptr_factory_.GetWeakPtr(), batch_id));
+  }
+}
+
+UpdateCheckResult SubscriptionServiceImpl::GetUpdateCheckResult() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return manual_result_;
+}
+
+void SubscriptionServiceImpl::OnManualCheckFinished(int batch_id, UpdateCheckResult result) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (manual_result_.batch_id != batch_id || !manual_result_.running) return;
+  manual_result_.checked += result.checked;
+  manual_result_.updated += result.updated;
+  manual_result_.failed += result.failed;
+  manual_result_.cancelled += result.cancelled;
+  manual_result_.timed_out += result.timed_out;
+  for (auto& entry : result.entries) manual_result_.entries.push_back(std::move(entry));
+  if (--manual_pending_configurations_ == 0) manual_result_.running = false;
+}
+
 bool SubscriptionServiceImpl::IsPrivilegedFiltersEnabled() {
   auto* adblock_filtering_configuration = GetAdblockFilteringConfiguration();
   return adblock_filtering_configuration->IsPrivilegedFiltersEnabled();
