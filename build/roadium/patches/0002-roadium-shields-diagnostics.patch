+  storage->Complete(false);
+  EXPECT_EQ(1, result.failed);
+  EXPECT_EQ(previous, maintainer->GetCurrentSubscriptions()[0]);
+  EXPECT_EQ(DiagnosticStage::Failed, metadata->GetDiagnostics(TestUrl()).stage);
+  EXPECT_NE(std::string::npos, metadata->GetDiagnostics(TestUrl()).error.find("Storage"));
+}
