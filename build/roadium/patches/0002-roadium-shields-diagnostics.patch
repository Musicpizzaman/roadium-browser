+  EXPECT_EQ(3, result.entries[0].outcome);
+  downloads->Complete(TestUrl(), true);
+  storage->Complete(true);
+  EXPECT_EQ(1, completions);
+  EXPECT_EQ(0, result.updated);
+  EXPECT_EQ(3, result.entries[0].outcome);
+  EXPECT_EQ(DiagnosticStage::Activated, metadata->GetDiagnostics(TestUrl()).stage);
