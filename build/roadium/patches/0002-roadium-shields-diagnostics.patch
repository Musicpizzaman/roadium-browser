diff --git a/components/adblock/android/java/src/org/chromium/components/adblock/ShieldsDiagnostics.java b/components/adblock/android/java/src/org/chromium/components/adblock/ShieldsDiagnostics.java
new file mode 100644
index 0000000..62e976b
--- /dev/null
+++ b/components/adblock/android/java/src/org/chromium/components/adblock/ShieldsDiagnostics.java
@@ -0,0 +1,173 @@
+// Copyright 2026 Roadium Browser contributors.
+// SPDX-License-Identifier: GPL-3.0-only
+package org.chromium.components.adblock;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.net.URL;
+import java.text.DateFormat;
+import java.util.Date;
+
+/** Read-only local snapshot. Conversion state is separate from engine activation. */
+public final class ShieldsDiagnostics {
+    private final JSONObject mData;
+    private final boolean mAvailable;
+
+    public ShieldsDiagnostics(String json) {
+        JSONObject data;
+        boolean available;
+        try {
+            data = new JSONObject(json);
+            available = data.has("blocking_enabled") && data.has("advanced_enabled")
+                    && data.optJSONArray("subscriptions") != null;
+        } catch (JSONException | NullPointerException e) {
+            data = new JSONObject();
+            available = false;
+        }
+        mData = data;
+        mAvailable = available;
+    }
+
+    public boolean isChecking() {
+        JSONObject update = mData.optJSONObject("update");
+        return mAvailable && update != null && update.optBoolean("running");
+    }
+
+    public String getUpdateSummary() {
+        if (!mAvailable) return "Update diagnostics unavailable";
+        JSONObject update = mData.optJSONObject("update");
+        if (update == null || update.optInt("batch_id") == 0)
+            return "No manual check requested in this session";
+        if (update.optBoolean("running")) return "Checking selected subscriptions…";
+        int checked = update.optInt("checked");
+        if (checked == 0) return "No selected subscriptions eligible for this check";
+        String text = "Checked " + checked + ": " + update.optInt("updated")
+                + " activated, " + update.optInt("failed") + " failed, "
+                + update.optInt("cancelled") + " cancelled, " + update.optInt("timed_out")
+                + " timed out";
+        if (update.optInt("timed_out") > 0)
+            text += ". Automatic downloads may still be pending; see filter diagnostics.";
+        return text;
+    }
+
+    public String getOverview() {
+        if (!mAvailable) return "Filter diagnostics unavailable";
+        String easylist = mData.optString("easylist_url");
+        String anticv = mData.optString("anticv_url");
+        return "Ad blocking: " + (mData.optBoolean("blocking_enabled") ? "Enabled" : "Disabled")
+                + "\nAdvanced filtering: " + (mData.optBoolean("advanced_enabled") ? "Enabled" : "Disabled")
+                + "\nEasyList: " + operational(find(easylist))
+                + "\nAnti-circumvention: " + operational(find(anticv))
+                + ". Privileged scriptlets: "
+                + (find(anticv) != null && find(anticv).optBoolean("privileged_allowed")
+                        ? "eligible for supported rules" : "not eligible")
+                + "\nTap for local update errors and conversion counts.";
+    }
+
+    private JSONObject find(String url) {
+        JSONArray subscriptions = mData.optJSONArray("subscriptions");
+        if (subscriptions == null) return null;
+        for (int i = 0; i < subscriptions.length(); i++) {
+            JSONObject sub = subscriptions.optJSONObject(i);
+            if (sub != null && url.equals(sub.optString("url"))) return sub;
+        }
+        return null;
+    }
+
+    private String operational(JSONObject sub) {
+        if (sub == null) return "not selected";
+        if (!mData.optBoolean("blocking_enabled")) return "paused (ad blocking off)";
+        if (sub.optBoolean("active")) {
+            JSONObject counts = sub.optJSONObject("active_rules");
+            return counts != null && counts.optInt("accepted") == 0
+                    ? "loaded with zero accepted rules" : "loaded in the active engine";
+        }
+        return "selected; no active data";
+    }
+
+    public String describeSubscription(URL url) {
+        if (!mAvailable) return "Filter diagnostics unavailable";
+        JSONObject sub = find(url.toString());
+        return sub == null ? "Not selected" : describe(sub);
+    }
+
+    private String describe(JSONObject sub) {
+        String version = sub.optString("version");
+        String stored = sub.optString("stored_version");
+        String text = "Engine: " + operational(sub)
+                + "\nState: " + sub.optString("state", "Unknown")
+                + "\nLoaded version: " + (version.isEmpty() ? "not available" : version)
+                + "\nStored version: " + (stored.isEmpty() || stored.equals("0") ? "not recorded/provided" : stored)
+                + "\nLast installation: " + date(sub.optLong("installed_at"))
+                + "\nLast successful activation/update: " + date(sub.optLong("last_success"))
+                + "\nLatest attempt: " + stage(sub.optInt("stage"))
+                + "; downloaded " + (sub.optInt("stage") == 0 ? "not recorded" : yesNo(sub.optBoolean("downloaded")))
+                + ", parsed " + (sub.optInt("stage") == 0 ? "not recorded" : yesNo(sub.optBoolean("parsed")))
+                + "\nLatest source: " + sub.optString("source", "not recorded")
+                + "\nLast active source: " + sub.optString("last_success_source", "not recorded")
+                + "\nSuccessful requests: " + sub.optLong("successful_requests") + " (includes HEAD)"
+                + "\nRecorded consecutive download failures: " + sub.optLong("consecutive_failures");
+        String error = sub.optString("error");
+        text += "\nLatest error: " + (error.isEmpty() ? "none recorded" : error);
+        JSONObject rules = sub.optJSONObject("rules");
+        if (rules == null) return text + "\nLatest conversion counts: not recorded";
+        return text + "\nLatest conversion: " + rules.optInt("accepted") + " accepted; rejected — parser "
+                + rules.optInt("parser_rejected") + ", unsupported commands "
+                + rules.optInt("unsupported_commands") + ", privilege "
+                + rules.optInt("prohibited_privilege") + ", arguments "
+                + rules.optInt("unsafe_arguments") + ", unsupported options/no operation "
+                + rules.optInt("unsupported_options");
+    }
+
+    public String getFullReport() {
+        if (!mAvailable) return "Filter diagnostics unavailable";
+        StringBuilder report = new StringBuilder(getOverview()).append("\n\n")
+                .append(getUpdateSummary());
+        JSONObject update = mData.optJSONObject("update");
+        JSONArray outcomes = update == null ? null : update.optJSONArray("entries");
+        if (outcomes != null && outcomes.length() > 0) {
+            report.append("\nManual check results:");
+            for (int i = 0; i < outcomes.length(); i++) {
+                JSONObject entry = outcomes.optJSONObject(i);
+                if (entry == null) continue;
+                int outcome = entry.optInt("outcome", -1);
+                String label = outcome == 0 ? "activated" : outcome == 1 ? "failed"
+                        : outcome == 2 ? "cancelled" : outcome == 3 ? "timed out" : "unknown";
+                report.append("\n").append(entry.optString("url")).append(": ").append(label);
+                String error = entry.optString("error");
+                if (!error.isEmpty()) report.append(" — ").append(error);
+            }
+        }
+        JSONArray subscriptions = mData.optJSONArray("subscriptions");
+        for (int i = 0; i < subscriptions.length(); i++) {
+            JSONObject sub = subscriptions.optJSONObject(i);
+            if (sub == null) continue;
+            report.append("\n\n").append(sub.optString("title")).append("\n")
+                    .append(sub.optString("url")).append("\n").append(describe(sub));
+        }
+        return report.toString();
+    }
+
+    private static String yesNo(boolean value) { return value ? "Yes" : "No"; }
+
+    private static String date(long millis) {
+        return millis <= 0 ? "not recorded" : DateFormat.getDateTimeInstance(
+                DateFormat.SHORT, DateFormat.MEDIUM).format(new Date(millis));
+    }
+
+    private static String stage(int stage) {
+        switch (stage) {
+            case 1: return "download requested/in progress";
+            case 2: return "downloaded; awaiting conversion";
+            case 3: return "parsed; awaiting storage/activation";
+            case 4: return "activated";
+            case 5: return "failed";
+            case 6: return "cancelled";
+            case 7: return "waiting for automatic retry";
+            case 8: return "interrupted";
+            default: return "not recorded";
+        }
+    }
+}
