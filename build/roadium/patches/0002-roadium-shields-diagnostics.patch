+TEST_F(ShieldsLifecycleTest, SuccessWaitsForStorageAndCollectionActivation) {
+  Prepare();
+  Check();
+  EXPECT_EQ(1, downloads->requests);  // Manual check joined initial installation.
+  downloads->Complete(TestUrl(), true);
+  EXPECT_EQ(0, completions);
+  EXPECT_TRUE(metadata->GetDiagnostics(TestUrl()).last_success.is_null());
+  storage->Complete(true);
+  EXPECT_EQ(1, completions);
+  EXPECT_EQ(1, result.updated);
+  ASSERT_EQ(1u, result.entries.size());
+  EXPECT_EQ(TestUrl().spec(), result.entries[0].url);
+  EXPECT_EQ(0, result.entries[0].outcome);
+  EXPECT_EQ(DiagnosticStage::Activated, metadata->GetDiagnostics(TestUrl()).stage);
+  EXPECT_FALSE(metadata->GetDiagnostics(TestUrl()).last_success.is_null());
+  EXPECT_EQ(Subscription::InstallationState::Installed,
+            maintainer->GetCurrentSubscriptions()[0]->GetInstallationState());
+}
+
+TEST_F(ShieldsLifecycleTest, StorageFailureRetainsPreviousWorkingData) {
+  Prepare(true);
