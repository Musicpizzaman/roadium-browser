+class Resource : public AdblockResourceRequest {
+ public:
+  GURL url;
+  ResponseCallback response;
+  void Start(GURL u, Method, ResponseCallback cb, RetryPolicy, const std::string) override {
+    url = u;
+    response = std::move(cb);
+  }
+  void Redirect(GURL u, const std::string) override { url = u; }
+  size_t GetNumberOfRedirects() const override { return 0; }
+  void FailHttp() {
+    auto cb = response;
+    NotifyAttemptDiagnostic(url, net::ERR_HTTP_RESPONSE_CODE_FAILURE, 404, false);
+    cb.Run(url, {}, base::MakeRefCounted<net::HttpResponseHeaders>("HTTP/1.1 404 Not Found\r\n\r\n"));
+  }
+  void Deliver() {
+    auto cb = response;
+    cb.Run(url, base::FilePath(FILE_PATH_LITERAL("fixture.txt")), nullptr);
+  }
+};
+
+TEST_F(ShieldsLifecycleTest, HttpFailureHasReasonAndDoesNotClaimParsedOrActive) {
+  Resource* request = nullptr;
+  SubscriptionDownloaderImpl downloader(base::BindLambdaForTesting([&request]() -> std::unique_ptr<AdblockResourceRequest> {
+    auto result = std::make_unique<Resource>();
+    request = result.get();
+    return result;
+  }), &conversion, metadata.get());
+  int failures = 0;
+  downloader.StartDownload(TestUrl(), AdblockResourceRequest::RetryPolicy::DoNotRetry,
+      base::BindLambdaForTesting([&failures](std::unique_ptr<FlatbufferData> data) { EXPECT_FALSE(data); ++failures; }));
+  request->FailHttp();
+  EXPECT_EQ(1, failures);
+  const auto d = metadata->GetDiagnostics(TestUrl());
+  EXPECT_EQ(DiagnosticStage::Failed, d.stage);
+  EXPECT_EQ("HTTP 404", d.error);
+  EXPECT_FALSE(d.downloaded);
+  EXPECT_FALSE(d.parsed);
+  EXPECT_TRUE(d.last_success.is_null());
+}
+
+TEST_F(ShieldsLifecycleTest, StaleConversionCannotCompleteReplacementDownload) {
+  Resource* request = nullptr;
+  SubscriptionDownloaderImpl downloader(base::BindLambdaForTesting([&request]() -> std::unique_ptr<AdblockResourceRequest> {
+    auto result = std::make_unique<Resource>();
+    request = result.get();
+    return result;
+  }), &conversion, metadata.get());
+  int finished = 0;
+  auto callback = [&finished]() { return base::BindLambdaForTesting([&finished](std::unique_ptr<FlatbufferData> data) { EXPECT_TRUE(data); ++finished; }); };
+  downloader.StartDownload(TestUrl(), AdblockResourceRequest::RetryPolicy::DoNotRetry, callback());
+  request->Deliver();
+  ASSERT_EQ(1u, conversion.callbacks.size());
+  downloader.CancelDownload(TestUrl());
+  downloader.StartDownload(TestUrl(), AdblockResourceRequest::RetryPolicy::DoNotRetry, callback());
+  std::move(conversion.callbacks[0]).Run(Data(TestUrl()));
+  EXPECT_EQ(0, finished);
+  EXPECT_EQ(DiagnosticStage::Downloading, metadata->GetDiagnostics(TestUrl()).stage);
+  request->Deliver();
+  std::move(conversion.callbacks[1]).Run(Data(TestUrl()));
+  EXPECT_EQ(1, finished);
+  EXPECT_EQ(DiagnosticStage::Parsed, metadata->GetDiagnostics(TestUrl()).stage);
+  EXPECT_TRUE(metadata->GetDiagnostics(TestUrl()).last_success.is_null());
+}
