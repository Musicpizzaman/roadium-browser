+    }
+
+    @Test public void emptyAndUnavailableStatesCannotRemainChecking() throws Exception {
+        JSONObject data = snapshot().put("update", new JSONObject().put("batch_id", 1));
+        assertTrue(new ShieldsDiagnostics(data.toString()).getUpdateSummary().contains("No selected subscriptions"));
+        assertFalse(new ShieldsDiagnostics("invalid").isChecking());
