+class DeferredStorage : public SubscriptionPersistentStorage {
+ public:
+  std::vector<scoped_refptr<InstalledSubscription>> initial;
+  std::unique_ptr<FlatbufferData> candidate;
+  StoreCallback store_callback;
+  void LoadSubscriptions(LoadCallback callback) override {
+    std::move(callback).Run(initial);
+  }
+  void StoreSubscription(std::unique_ptr<FlatbufferData> data, StoreCallback callback) override {
+    candidate = std::move(data);
+    store_callback = std::move(callback);
+  }
+  void RemoveSubscription(scoped_refptr<InstalledSubscription>) override {}
+  void Complete(bool success) {
+    scoped_refptr<InstalledSubscription> subscription;
+    if (success) subscription = base::MakeRefCounted<InstalledSubscriptionImpl>(
+        std::move(candidate), Subscription::InstallationState::Installed, base::Time::Now());
+    std::move(store_callback).Run(subscription);
+  }
+};
+
+class DeferredDownloads : public SubscriptionDownloader {
+ public:
+  std::map<GURL, DownloadCompletedCallback> callbacks;
+  int requests = 0;
+  void StartDownload(const GURL& url, AdblockResourceRequest::RetryPolicy,
+                     DownloadCompletedCallback callback) override {
+    ++requests;
+    callbacks[url] = std::move(callback);
+  }
+  void CancelDownload(const GURL& url) override { callbacks.erase(url); }
+  void DoHeadRequest(const GURL&, HeadRequestCallback callback) override {
+    std::move(callback).Run("");
+  }
+  void Complete(const GURL& url, bool success) {
+    auto node = callbacks.extract(url);
+    std::move(node.mapped()).Run(success ? Data(url) : nullptr);
+  }
+};
