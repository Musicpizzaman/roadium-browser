+static base::android::ScopedJavaLocalRef<jstring>
+JNI_AdblockController_GetDiagnosticSnapshot(JNIEnv* env,
+    const base::android::JavaRef<jobject>& context_handle) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto* context = content::BrowserContextFromJavaHandle(context_handle);
+  auto* service = adblock::SubscriptionServiceFactory::GetForBrowserContext(context);
+  auto* metadata = adblock::SubscriptionPersistentMetadataFactory::GetForBrowserContext(context);
+  if (!service || !metadata) return ConvertUTF8ToJavaString(env, "{}");
+  auto* configuration = service->GetAdblockFilteringConfiguration();
+  base::DictValue root;
+  root.Set("blocking_enabled", configuration->IsEnabled());
+  root.Set("advanced_enabled", service->IsPrivilegedFiltersEnabled());
+  root.Set("easylist_url", adblock::DefaultSubscriptionUrl().spec());
+  root.Set("anticv_url", "https://uazo.github.io/cromite/filters/abp-filters-anti-cv.txt");
+  const auto result = service->GetUpdateCheckResult();
+  base::DictValue update;
+  update.Set("batch_id", result.batch_id);
+  update.Set("checked", result.checked);
+  update.Set("updated", result.updated);
+  update.Set("failed", result.failed);
+  update.Set("cancelled", result.cancelled);
+  update.Set("timed_out", result.timed_out);
+  update.Set("running", result.running);
+  base::ListValue outcomes;
+  for (const auto& entry : result.entries) {
+    base::DictValue outcome;
+    outcome.Set("url", entry.url);
+    outcome.Set("configuration", entry.configuration);
+    outcome.Set("outcome", entry.outcome);
+    outcome.Set("error", entry.error);
+    outcomes.Append(std::move(outcome));
+  }
+  update.Set("entries", std::move(outcomes));
+  root.Set("update", std::move(update));
+  auto time = [](base::Time value) -> double {
+    return value.is_null() ? 0 : value.InMillisecondsFSinceUnixEpochIgnoringNull();
+  };
+  auto counts = [](const adblock::RuleStatistics& s) {
+    return base::DictValue().Set("accepted", s.accepted)
+        .Set("parser_rejected", s.parser_rejected)
+        .Set("unsupported_commands", s.unsupported_commands)
+        .Set("prohibited_privilege", s.prohibited_privilege)
+        .Set("unsafe_arguments", s.unsafe_arguments)
+        .Set("unsupported_options", s.unsupported_options);
+  };
+  base::ListValue lists;
+  for (const auto& subscription : service->GetCurrentSubscriptions(configuration)) {
+    const auto url = subscription->GetSourceUrl();
+    const auto state = subscription->GetInstallationState();
+    const auto d = metadata->GetDiagnostics(url);
+    base::DictValue item;
+    item.Set("url", url.SchemeIs("data") ? "Inline subscription (contents omitted)" : url.spec());
+    std::string title = subscription->GetTitle();
+    if (title.empty()) {
+      for (const auto& known : adblock::config::GetKnownSubscriptions()) {
+        if (known.url == url) { title = known.title; break; }
+      }
+    }
+    item.Set("title", title.substr(0, 128));
+    item.Set("version", subscription->GetCurrentVersion().substr(0, 64));
+    item.Set("stored_version", metadata->GetVersion(url).substr(0, 64));
+    item.Set("state", adblock::Subscription::SubscriptionInstallationStateToString(state));
+    item.Set("active", configuration->IsEnabled() &&
+        (state == adblock::Subscription::InstallationState::Installed ||
+         state == adblock::Subscription::InstallationState::AutoInstalled ||
+         state == adblock::Subscription::InstallationState::Preloaded));
+    item.Set("privileged_allowed", metadata->AllowPrivilegedFilters(url));
+    item.Set("installed_at", time(metadata->GetLastInstallationTime(url)));
+    item.Set("successful_requests", metadata->GetDownloadSuccessCount(url));
+    item.Set("consecutive_failures", metadata->GetDownloadErrorCount(url));
+    item.Set("stage", static_cast<int>(d.stage));
+    item.Set("downloaded", d.downloaded);
+    item.Set("parsed", d.parsed);
+    item.Set("error", d.error);
+    item.Set("source", d.source.empty() ? "not recorded" : d.source);
+    item.Set("last_success", time(d.last_success));
+    item.Set("last_success_source", d.last_success_source.empty() ? "not recorded" : d.last_success_source);
+    if (d.rules) item.Set("rules", counts(*d.rules));
+    if (d.active_rules) item.Set("active_rules", counts(*d.active_rules));
+    lists.Append(std::move(item));
+  }
+  root.Set("subscriptions", std::move(lists));
+  std::string json;
+  base::JSONWriter::Write(root, &json);
+  return ConvertUTF8ToJavaString(env, json);
+}
+
 DEFINE_JNI(AdblockController)
