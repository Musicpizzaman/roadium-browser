+class ShieldsLifecycleTest : public testing::Test {
+ public:
+  base::test::TaskEnvironment tasks{base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  TestingPrefServiceSimple prefs;
+  std::unique_ptr<SubscriptionPersistentMetadataImpl> metadata;
+  std::unique_ptr<PersistentFilteringConfiguration> configuration;
+  DeferredConversion conversion;
+  DeferredStorage* storage = nullptr;
+  DeferredDownloads* downloads = nullptr;
+  Scheduler* scheduler = nullptr;
+  std::unique_ptr<FilteringConfigurationMaintainerImpl> maintainer;
+  UpdateCheckResult result;
+  int completions = 0;
+
+  void SetUp() override {
+    common::prefs::RegisterProfilePrefs(prefs.registry());
+    metadata = std::make_unique<SubscriptionPersistentMetadataImpl>(&prefs);
+    configuration = std::make_unique<PersistentFilteringConfiguration>(&prefs, "adblock");
+    configuration->AddFilterList(TestUrl());
+  }
+  void Prepare(bool installed = false, bool initialize = true) {
+    auto disk = std::make_unique<DeferredStorage>();
+    storage = disk.get();
+    if (installed) storage->initial.push_back(Installed(TestUrl()));
+    auto network = std::make_unique<DeferredDownloads>();
+    downloads = network.get();
+    auto timer = std::make_unique<Scheduler>();
+    scheduler = timer.get();
+    maintainer = std::make_unique<FilteringConfigurationMaintainerImpl>(configuration.get(),
+        std::move(disk), std::move(network), nullptr, std::make_unique<EmptyPreloaded>(),
+        std::move(timer), &conversion, metadata.get(), base::BindRepeating([](const GURL&) {}));
+    if (initialize) maintainer->InitializeStorage();
+  }
+  void Check() {
+    maintainer->StartUpdateWithCallback(base::BindOnce(
+        [](ShieldsLifecycleTest* self, UpdateCheckResult r) { self->result = r; ++self->completions; },
+        base::Unretained(this)));
+  }
+};
