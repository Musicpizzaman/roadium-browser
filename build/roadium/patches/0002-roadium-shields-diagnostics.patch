+TEST(ShieldsServiceTest, BatchAggregatesOutcomesAndRepeatedTapsJoin) {
+  base::test::TaskEnvironment tasks;
+  TestingPrefServiceSimple prefs;
+  common::prefs::RegisterProfilePrefs(prefs.registry());
+  std::vector<BatchMaintainer*> maintainers;
+  SubscriptionServiceImpl service(&prefs,
+      base::BindLambdaForTesting([&maintainers](FilteringConfiguration*, SubscriptionServiceImpl::SubscriptionUpdatedCallback) -> std::unique_ptr<FilteringConfigurationMaintainer> {
+        auto result = std::make_unique<BatchMaintainer>();
+        maintainers.push_back(result.get());
+        return result;
+      }), base::BindRepeating([](FilteringConfiguration*) {}));
+  service.InstallFilteringConfiguration(std::make_unique<PersistentFilteringConfiguration>(&prefs, "adblock"));
+  service.InstallFilteringConfiguration(std::make_unique<PersistentFilteringConfiguration>(&prefs, "second"));
+  service.StartUpdateCheck();
+  const int batch = service.GetUpdateCheckResult().batch_id;
+  service.StartUpdateCheck();
+  EXPECT_EQ(1, maintainers[0]->checks);
+  EXPECT_EQ(batch, service.GetUpdateCheckResult().batch_id);
+  UpdateCheckResult first; first.checked = 2; first.updated = 1; first.failed = 1;
+  std::move(maintainers[0]->callback).Run(first);
+  EXPECT_TRUE(service.GetUpdateCheckResult().running);
+  UpdateCheckResult second; second.checked = 1; second.cancelled = 1;
+  std::move(maintainers[1]->callback).Run(second);
+  const auto result = service.GetUpdateCheckResult();
+  EXPECT_FALSE(result.running);
+  EXPECT_EQ(3, result.checked);
+  EXPECT_EQ(1, result.updated);
+  EXPECT_EQ(1, result.failed);
+  EXPECT_EQ(1, result.cancelled);
+}
