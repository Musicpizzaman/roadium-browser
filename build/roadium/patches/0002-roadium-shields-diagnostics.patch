+class BatchMaintainer : public FilteringConfigurationMaintainer {
+ public:
+  int checks = 0;
+  base::OnceCallback<void(UpdateCheckResult)> callback;
+  void StartUpdate() override {}
+  void StartUpdateWithCallback(base::OnceCallback<void(UpdateCheckResult)> cb) override { ++checks; callback = std::move(cb); }
+  raw_ptr<SubscriptionPersistentMetadata> GetMetadata() override { return nullptr; }
+  std::unique_ptr<SubscriptionCollection> GetSubscriptionCollection() const override { return nullptr; }
+  std::vector<scoped_refptr<Subscription>> GetCurrentSubscriptions() const override { return {}; }
+  void RemoveAutoInstalledSubscriptions() override {}
+};
