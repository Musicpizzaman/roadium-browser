+      diagnostic.stage = DiagnosticStage::Failed;
+      diagnostic.error = "Subscription storage still initializing; check could not start";
+      persistent_metadata_->SetDiagnostics(url, diagnostic);
+    }
+    FinishAllManual(ManualOutcome::Failed);
+    return;
+  }
+  // Bound only the manual result window. Existing automatic retry/backoff
+  // continues independently; a timed-out check never reports activation.
+  manual_deadline_.Start(FROM_HERE, base::Seconds(45),
+      base::BindOnce(&FilteringConfigurationMaintainerImpl::FinishAllManual,
+                    weak_ptr_factory_.GetWeakPtr(), ManualOutcome::TimedOut));
+  for (const auto& url : urls) {
+    if (std::ranges::find(ongoing_installations_, url, &Subscription::GetSourceUrl) == ongoing_installations_.end())
+      DownloadAndInstallSubscription(url);
+  }
