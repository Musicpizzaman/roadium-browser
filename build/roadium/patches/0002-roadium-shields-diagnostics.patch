+                .describeSubscription(new URL("https://example.com/easylist.txt"));
+        assertTrue(text.contains("no active data"));
+        assertTrue(text.contains("parsed; awaiting storage/activation"));
+        assertTrue(text.contains("downloaded Yes, parsed Yes"));
+        assertTrue(text.contains("Last successful activation/update: not recorded"));
+    }
+
+    @Test public void legacyHistoryStaysUnknownRatherThanFalse() throws Exception {
+        JSONObject data = snapshot();
