index 0000000..36263ef
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/page_info/ShieldsPageInfoController.java
@@ -0,0 +1,278 @@
+// Copyright 2026 Roadium Browser contributors.
+// SPDX-License-Identifier: GPL-3.0-only
+package org.chromium.chrome.browser.page_info;
+
+import android.content.Context;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import org.chromium.chrome.browser.adblock.R;
+import org.chromium.chrome.browser.adblock.settings.AdblockSettingsFragment;
+import org.chromium.chrome.browser.settings.SettingsNavigationFactory;
+import org.chromium.components.adblock.AdblockController;
+import org.chromium.components.adblock.ShieldsPresets;
+import org.chromium.components.adblock.ShieldsSiteState;
+import org.chromium.components.page_info.PageInfoMainController;
+import org.chromium.components.page_info.PageInfoRowView;
+import org.chromium.components.page_info.PageInfoSubpageController;
+import org.chromium.content_public.browser.NavigationHandle;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.content_public.browser.WebContentsObserver;
+
+import java.util.List;
+
+/** Local, synchronous snapshot. No request logging, uploads or background activity observer. */
+public final class ShieldsPageInfoController implements PageInfoSubpageController {
+    private final PageInfoMainController mMain;
+    private final PageInfoRowView mRow;
+    private final WebContents mContents;
+    private final AdblockController mController;
+    private final String mHost;
+    private final String mUrl;
+    private ScrollView mView;
+    private LinearLayout mBody;
+    private WebContentsObserver mObserver;
+    private boolean mInvalidated;
+    private android.app.AlertDialog mDiagnostics;
+
+    public ShieldsPageInfoController(
+            PageInfoMainController main,
+            PageInfoRowView row,
+            WebContents contents,
+            AdblockController controller) {
+        mMain = main;
+        mRow = row;
+        mContents = contents;
+        mController = controller;
+        mHost = ShieldsSiteState.canonicalHost(main.getURL().getHost());
+        mUrl = main.getURL().getSpec();
+        updateRowIfNeeded();
+    }
+
+    private String text(int id) {
+        return mRow.getContext().getString(id);
+    }
+
+    private boolean isCurrent() {
+        return !mInvalidated
+                && !mContents.isDestroyed()
+                && mUrl.equals(mContents.getLastCommittedUrl().getSpec());
+    }
+
+    @Override
+    public String getSubpageTitle() {
+        return text(R.string.roadium_shields_site_panel_title);
+    }
+
+    @Override
+    public View createViewForSubpage(ViewGroup parent) {
+        mInvalidated = false;
+        Context context = parent.getContext();
+        mView = new ScrollView(context);
+        mBody = new LinearLayout(context);
+        mBody.setOrientation(LinearLayout.VERTICAL);
+        int pad = Math.round(16 * context.getResources().getDisplayMetrics().density);
+        mBody.setPadding(pad, pad, pad, pad);
+        mView.addView(mBody);
+        mObserver =
+                new WebContentsObserver(mContents) {
+                    @Override
+                    public void didStartNavigationInPrimaryMainFrame(NavigationHandle navigation) {
+                        mInvalidated = true;
+                        mMain.dismiss();
+                    }
+
+                    @Override
+                    public void webContentsDestroyed() {
+                        mInvalidated = true;
+                        mMain.dismiss();
+                    }
+                };
+        render();
+        return mView;
+    }
+
+    private void line(String value) {
+        TextView view = new TextView(mBody.getContext());
+        view.setText(value);
+        view.setTextSize(16);
+        view.setPadding(0, 8, 0, 8);
+        view.setTextIsSelectable(true);
+        mBody.addView(view);
+    }
+
+    private void button(int title, Runnable action) {
+        Button button = new Button(mBody.getContext());
+        button.setText(title);
+        button.setAllCaps(false);
+        button.setMinHeight(Math.round(56 * button.getResources().getDisplayMetrics().density));
+        button.setOnClickListener(
+                v -> {
+                    if (isCurrent()) action.run();
+                    else mMain.dismiss();
+                });
+        mBody.addView(
+                button,
+                new LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+    }
+
+    private int levelName() {
+        switch (ShieldsPresets.currentLevel(mController.getSelectedFilterLists())) {
+            case STANDARD:
+                return R.string.roadium_shields_standard;
+            case BALANCED:
+                return R.string.roadium_shields_balanced;
+            case STRICT:
+                return R.string.roadium_shields_strict;
+            default:
+                return R.string.roadium_shields_custom;
+        }
+    }
+
+    private int status(List<String> saved, List<String> session) {
+        switch (ShieldsSiteState.effective(
+                mController.isEnabled(), !saved.isEmpty(), !session.isEmpty())) {
+            case GLOBAL_PAUSED:
+                return R.string.roadium_shields_site_global_paused;
+            case SAVED_EXCEPTION:
+                return R.string.roadium_shields_site_saved_off;
+            case SESSION_EXCEPTION:
+                return R.string.roadium_shields_site_session_off;
+            default:
+                return R.string.roadium_shields_site_enabled;
+        }
+    }
+
+    private void render() {
+        if (!isCurrent() || mBody == null) {
+            mMain.dismiss();
+            return;
+        }
+        mBody.removeAllViews();
+        List<String> saved = ShieldsSiteState.covering(mHost, mController.getAllowedDomains());
+        List<String> session =
+                ShieldsSiteState.covering(mHost, mController.getTemporaryAllowedDomains());
+        line(mHost);
+        line(text(status(saved, session)));
+        line(text(R.string.roadium_shields_site_level) + ": " + text(levelName()));
+        int count = AdblockController.getPageBlockedRequests(mContents);
+        line(
+                count < 0
+                        ? text(R.string.roadium_shields_site_activity_unavailable)
+                        : text(R.string.roadium_shields_site_activity) + ": " + count);
+        if (saved.isEmpty()) {
+            button(
+                    R.string.roadium_shields_site_save_off,
+                    () -> {
+                        mController.addAllowedDomain(mHost);
+                        reload();
+                    });
+        }
+        if (session.isEmpty() && saved.isEmpty()) {
+            button(
+                    R.string.roadium_shields_site_session_action,
+                    () -> {
+                        mController.addTemporaryAllowedDomain(mHost);
+                        reload();
+                    });
+        }
+        for (String domain : saved) {
+            line(text(R.string.roadium_shields_site_exception_scope) + " " + domain);
+            button(
+                    R.string.roadium_shields_site_remove_saved,
+                    () -> {
+                        mController.removeAllowedDomain(domain);
+                        reload();
+                    });
+        }
+        for (String domain : session) {
+            line(text(R.string.roadium_shields_site_exception_scope) + " " + domain);
+            button(
+                    R.string.roadium_shields_site_remove_session,
+                    () -> {
+                        mController.removeTemporaryAllowedDomain(domain);
+                        reload();
+                    });
+        }
+        line(text(R.string.roadium_shields_site_scope));
+        line(text(R.string.roadium_shields_site_activity_scope));
+        line(text(R.string.roadium_shields_site_attribution));
+        button(R.string.roadium_shields_site_refresh, this::render);
+        button(R.string.roadium_shields_site_reload, this::reload);
+        button(
+                R.string.roadium_shields_site_settings,
+                () -> {
+                    mMain.dismiss();
+                    SettingsNavigationFactory.createSettingsNavigation()
+                            .startSettings(mRow.getContext(), AdblockSettingsFragment.class);
+                });
+        button(
+                R.string.roadium_shields_site_diagnostics,
+                () -> {
+                    // Read-only existing local diagnostics, no submission path.
+                    TextView report = new TextView(mRow.getContext());
+                    report.setText(mController.getDiagnostics().getFullReport());
+                    report.setTextIsSelectable(true);
+                    ScrollView scroll = new ScrollView(mRow.getContext());
+                    scroll.addView(report);
+                    mDiagnostics =
+                            new android.app.AlertDialog.Builder(mRow.getContext())
+                                    .setTitle(R.string.roadium_shields_site_diagnostics)
+                                    .setView(scroll)
+                                    .setPositiveButton(android.R.string.ok, null)
+                                    .show();
+                });
+        line(text(R.string.roadium_shields_site_help));
+    }
+
+    private void reload() {
+        mMain.dismiss();
+        if (!mContents.isDestroyed()) mContents.getNavigationController().reload(true);
+    }
+
+    @Override
+    public View getCurrentSubpageView() {
+        return mView;
+    }
+
+    @Override
+    public void onSubpageRemoved() {
+        if (mObserver != null) {
+            mObserver.observe(null);
+            mObserver = null;
+        }
+        if (mDiagnostics != null) {
+            mDiagnostics.dismiss();
+            mDiagnostics = null;
+        }
+        mView = null;
+        mBody = null;
+    }
+
+    @Override
+    public void clearData() {}
+
+    @Override
+    public void updateRowIfNeeded() {
+        PageInfoRowView.ViewParams params = new PageInfoRowView.ViewParams();
+        params.visible = isCurrent();
+        params.title = getSubpageTitle();
+        params.subtitle = mHost;
+        params.iconResId = org.chromium.components.browser_ui.styles.R.drawable.ic_shield_24dp;
+        params.clickCallback =
+                () -> {
+                    if (isCurrent()) mMain.launchSubpage(this);
+                };
+        mRow.setParams(params);
+    }
+
+    @Override
+    public void updateSubpageIfNeeded() {
+        if (mView != null) render();
+    }
+}
