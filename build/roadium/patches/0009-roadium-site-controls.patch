--- /dev/null
+++ b/components/adblock/android/java/src/org/chromium/components/adblock/ShieldsSiteState.java
@@ -0,0 +1,68 @@
+// Copyright 2026 Roadium Browser contributors.
+// SPDX-License-Identifier: GPL-3.0-only
+package org.chromium.components.adblock;
+
+import java.net.IDN;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/** Read-only site scope model. Matches existing domain allowlisting, including subdomains. */
+public final class ShieldsSiteState {
+    private ShieldsSiteState() {}
+
+    /** DNS/IPv4 host only. No paths, ports, wildcards or rule syntax. IPv6 is unsupported here. */
+    public static String canonicalHost(String host) {
+        if (host == null || host.isEmpty() || !host.equals(host.trim())) return null;
+        if (host.endsWith(".")) host = host.substring(0, host.length() - 1);
+        try {
+            String ascii = IDN.toASCII(host, IDN.USE_STD3_ASCII_RULES).toLowerCase(Locale.ROOT);
+            if (ascii.isEmpty() || ascii.length() > 253 || ascii.contains("..")) return null;
+            return ascii;
+        } catch (IllegalArgumentException e) {
+            return null;
+        }
+    }
+
+    public static boolean supports(String scheme, String host) {
+        return ("http".equals(scheme) || "https".equals(scheme)) && canonicalHost(host) != null;
+    }
+
+    /** Returns original stored entries, so restoring never rewrites another owner's record. */
+    public static List<String> covering(String host, List<String> domains) {
+        List<String> matching = new ArrayList<>();
+        String canonical = canonicalHost(host);
+        if (canonical == null) return matching;
+        for (String entry : domains) {
+            // The engine rejects Unicode in stored domain options. Do not silently
+            // reinterpret a legacy record as a working punycode exception.
+            String domain = isAscii(entry) ? canonicalHost(entry) : null;
+            if (domain != null && (canonical.equals(domain) || canonical.endsWith("." + domain))) {
+                matching.add(entry);
+            }
+        }
+        return matching;
+    }
+
+    private static boolean isAscii(String value) {
+        if (value == null) return false;
+        for (int i = 0; i < value.length(); i++) {
+            if (value.charAt(i) > 0x7f) return false;
+        }
+        return true;
+    }
+
+    public enum Effective {
+        GLOBAL_PAUSED,
+        SAVED_EXCEPTION,
+        SESSION_EXCEPTION,
+        FILTERING_ENABLED
+    }
+
+    public static Effective effective(boolean enabled, boolean saved, boolean temporary) {
+        if (!enabled) return Effective.GLOBAL_PAUSED;
+        if (saved) return Effective.SAVED_EXCEPTION;
+        if (temporary) return Effective.SESSION_EXCEPTION;
+        return Effective.FILTERING_ENABLED;
+    }
+}
