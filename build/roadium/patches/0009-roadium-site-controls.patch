@@ -0,0 +1,103 @@
+// Copyright 2026 Roadium Browser contributors.
+// SPDX-License-Identifier: GPL-3.0-only
+package org.chromium.components.adblock;
+
+import static org.junit.Assert.*;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.base.test.util.Batch;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import java.util.Arrays;
+import java.util.List;
+
+@RunWith(BaseRobolectricTestRunner.class)
+@Batch(Batch.UNIT_TESTS)
+public class ShieldsSiteStateTest {
+    @Test
+    public void idnCaseAndFinalDotCanonicalizeWithoutWideningScope() {
+        assertEquals("xn--bcher-kva.example", ShieldsSiteState.canonicalHost("Bücher.Example."));
+        assertEquals(
+                Arrays.asList("XN--BCHER-KVA.example"),
+                ShieldsSiteState.covering(
+                        "shop.xn--bcher-kva.example",
+                        Arrays.asList("XN--BCHER-KVA.example", "other.example")));
+    }
+
+    @Test
+    public void legacyUnicodeRecordIsPreservedButNeverClaimedAsActiveException() {
+        List<String> original = Arrays.asList("B\u00dcCHER.example", "XN--BCHER-KVA.example");
+        assertEquals(
+                Arrays.asList("XN--BCHER-KVA.example"),
+                ShieldsSiteState.covering("shop.xn--bcher-kva.example", original));
+        assertEquals(Arrays.asList("B\u00dcCHER.example", "XN--BCHER-KVA.example"), original);
+        assertTrue(
+                ShieldsSiteState.covering("xn--bcher-kva.example", Arrays.asList("B\u00dcCHER.example"))
+                        .isEmpty());
+    }
+
+    @Test
+    public void suffixRequiresDnsLabelBoundary() {
+        List<String> domains = Arrays.asList("example.com", "shop.example.com", "other.com");
+        assertEquals(
+                Arrays.asList("example.com", "shop.example.com"),
+                ShieldsSiteState.covering("shop.example.com", domains));
+        assertTrue(ShieldsSiteState.covering("badexample.com", domains).isEmpty());
+        assertTrue(ShieldsSiteState.covering("example.com.evil.test", domains).isEmpty());
+        assertEquals(3, domains.size());
+    }
+
+    @Test
+    public void malformedHostsAndRuleInjectionAreRejected() {
+        for (String host :
+                Arrays.asList(
+                        "",
+                        " ",
+                        " example.com",
+                        "example.com ",
+                        ".",
+                        "a..example",
+                        "example.com:443",
+                        "example.com/path",
+                        "example.com^$document",
+                        "user@example.com",
+                        "[::1]",
+                        "*.example.com",
+                        "example.com\n")) {
+            assertNull(host, ShieldsSiteState.canonicalHost(host));
+        }
+    }
+
+    @Test
+    public void nonWebPagesHaveNoSiteControls() {
+        for (String scheme : Arrays.asList("chrome", "file", "data", "about", "javascript", "ftp"))
+            assertFalse(ShieldsSiteState.supports(scheme, "example.com"));
+        assertTrue(ShieldsSiteState.supports("https", "example.com"));
+        assertTrue(ShieldsSiteState.supports("http", "127.0.0.1"));
+        assertFalse(ShieldsSiteState.supports("https", "[::1]"));
+    }
+
+    @Test
+    public void globalPauseAlwaysWinsOverEitherException() {
+        for (boolean saved : new boolean[] {false, true})
+            for (boolean temporary : new boolean[] {false, true}) {
+                assertEquals(
+                        ShieldsSiteState.Effective.GLOBAL_PAUSED,
+                        ShieldsSiteState.effective(false, saved, temporary));
+            }
+    }
+
+    @Test
+    public void concurrentExceptionsRemainDistinctReasons() {
+        assertEquals(
+                ShieldsSiteState.Effective.SAVED_EXCEPTION,
+                ShieldsSiteState.effective(true, true, true));
+        assertEquals(
+                ShieldsSiteState.Effective.SESSION_EXCEPTION,
+                ShieldsSiteState.effective(true, false, true));
+        assertEquals(
+                ShieldsSiteState.Effective.FILTERING_ENABLED,
+                ShieldsSiteState.effective(true, false, false));
+    }
+}
