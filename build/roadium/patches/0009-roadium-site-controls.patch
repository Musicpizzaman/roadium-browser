+static jint JNI_AdblockController_GetPageBlockedRequests(
+    JNIEnv* env,
+    const base::android::JavaRef<jobject>& j_contents) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto* contents = content::WebContents::FromJavaWebContents(j_contents);
+  if (!contents || contents->IsBeingDestroyed()) {
+    return -1;
+  }
+  auto* info = adblock::EyeoPageInfo::GetForPage(contents->GetPrimaryPage());
+  return info ? info->GetBlockedRequests() : 0;
+}
