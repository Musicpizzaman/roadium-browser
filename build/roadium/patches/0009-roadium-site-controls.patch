@@ -0,0 +1,93 @@
+// Copyright 2026 Roadium Browser contributors.
+// SPDX-License-Identifier: GPL-3.0-only
+#include "components/adblock/core/common/adblock_prefs.h"
+#include "components/adblock/core/configuration/persistent_filtering_configuration.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace adblock {
+namespace {
+class SiteObserver : public FilteringConfiguration::Observer {
+ public:
+  void OnAllowedDomainsChanged(FilteringConfiguration*) override { ++changed; }
+  int changed = 0;
+};
+
+TEST(ShieldsSites, SessionChangesNeverPersistOrEraseSavedOwnership) {
+  TestingPrefServiceSimple prefs;
+  common::prefs::RegisterProfilePrefs(prefs.registry());
+  {
+    PersistentFilteringConfiguration config(&prefs, "adblock");
+    config.AddAllowedDomain("saved.example");
+    config.AddCustomFilter("||ads.example^");
+    config.SetEnabled(false);
+    config.SetPrivilegedFiltersEnabled(false);
+    const auto before =
+        prefs.GetValue(common::prefs::kConfigurationsPrefsPath).Clone();
+    SiteObserver observer;
+    config.AddObserver(&observer);
+    config.AddTemporaryAllowedDomain("saved.example");
+    config.AddTemporaryAllowedDomain("session.example");
+    config.AddTemporaryAllowedDomain("session.example");
+    config.RemoveTemporaryAllowedDomain("missing.example");
+    EXPECT_EQ(2, observer.changed);
+    EXPECT_EQ(before, prefs.GetValue(common::prefs::kConfigurationsPrefsPath));
+    EXPECT_EQ((std::vector<std::string>{"saved.example"}),
+              config.GetAllowedDomains());
+    config.RemoveTemporaryAllowedDomain("saved.example");
+    EXPECT_EQ(3, observer.changed);
+    EXPECT_EQ((std::vector<std::string>{"saved.example"}),
+              config.GetAllowedDomains());
+    config.AddAllowedDomain("session.example");
+    config.RemoveTemporaryAllowedDomain("session.example");
+    EXPECT_EQ((std::vector<std::string>{"saved.example", "session.example"}),
+              config.GetAllowedDomains());
+    config.AddTemporaryAllowedDomain("never-written.example");
+    config.AddCustomFilter("##.unrelated-change");
+    config.SetFilterLists({GURL("https://example.test/custom.txt")});
+    EXPECT_FALSE(config.IsEnabled());
+    EXPECT_FALSE(config.IsPrivilegedFiltersEnabled());
+    config.RemoveObserver(&observer);
+  }
+  PersistentFilteringConfiguration restarted(&prefs, "adblock");
+  EXPECT_TRUE(restarted.GetTemporaryAllowedDomains().empty());
+  EXPECT_EQ((std::vector<std::string>{"saved.example", "session.example"}),
+            restarted.GetAllowedDomains());
+  EXPECT_EQ(2u, restarted.GetCustomFilters().size());
+  EXPECT_FALSE(restarted.IsEnabled());
+  EXPECT_FALSE(restarted.IsPrivilegedFiltersEnabled());
+}
+
+TEST(ShieldsSites, RemovingSavedExceptionDoesNotClearConcurrentSession) {
+  TestingPrefServiceSimple prefs;
+  common::prefs::RegisterProfilePrefs(prefs.registry());
+  PersistentFilteringConfiguration config(&prefs, "adblock");
+  config.AddTemporaryAllowedDomain("same.example");
+  config.AddAllowedDomain("same.example");
+  config.RemoveAllowedDomain("same.example");
+  EXPECT_EQ((std::vector<std::string>{"same.example"}),
+            config.GetTemporaryAllowedDomains());
+  EXPECT_TRUE(config.GetAllowedDomains().empty());
+}
+
+TEST(ShieldsSites, InvalidSessionHostCannotInjectRuleSyntaxOrNotify) {
+  TestingPrefServiceSimple prefs;
+  common::prefs::RegisterProfilePrefs(prefs.registry());
+  PersistentFilteringConfiguration config(&prefs, "adblock");
+  const auto before =
+      prefs.GetValue(common::prefs::kConfigurationsPrefsPath).Clone();
+  SiteObserver observer;
+  config.AddObserver(&observer);
+  for (const auto* host :
+       {"", "bad.example/path", "bad.example#x", "bad.example?x",
+        "bad.example:443", "user@bad.example", "bad.example^$document",
+        "bad.example\n@@||other.example", "UPPER.example"}) {
+    config.AddTemporaryAllowedDomain(host);
+  }
+  EXPECT_TRUE(config.GetTemporaryAllowedDomains().empty());
+  EXPECT_EQ(0, observer.changed);
+  EXPECT_EQ(before, prefs.GetValue(common::prefs::kConfigurationsPrefsPath));
+  config.RemoveObserver(&observer);
+}
